# Every variable the code reads. Never put a real value in this file.

# --- Build time (astro.config.mjs) ---
# Optional. Absolute site origin used for canonical URLs, RSS, and the sitemap.
# Default: https://aitamer.news.
ASTRO_SITE=

# Optional. Path prefix the site is served under (applied through withBase() in
# src/lib/site.ts). Default: /. Supported for a future base-path deployment
# target; nothing sets it today.
ASTRO_BASE=

# --- Build time, public (these end up in the page, so they must never be secret) ---
# Optional. Where the About form posts. Default: https://contact.aitamer.news/
# Point it at `npm run dev:contact` (http://localhost:8787/) for local work.
PUBLIC_CONTACT_ENDPOINT=

# Optional. Where the comment form on story pages posts (the desk's comments Worker, which lives
# in the atn-ops repository). Default: https://comments.aitamer.news/. Point it at a local copy of
# that Worker for local work. Must be an absolute http(s) URL; anything else makes the page say
# commenting is not set up. The form also needs TURNSTILE_SITE_KEY in src/lib/site.ts.
PUBLIC_COMMENTS_ENDPOINT=

# Optional. Rewrites hero image URLs on media.aitamer.news to this base instead, for local or
# offline work (src/lib/media.ts). Default: empty, meaning hero images load from
# media.aitamer.news as production does. Set it to /media-local and put files under the
# git-ignored public/media-local/heroes/ to work offline.
PUBLIC_MEDIA_BASE=

# --- Contact Worker secrets (workers/contact) — set with wrangler, never in the site build ---
#   npx wrangler secret put CONTACT_TO --config workers/contact/wrangler.toml
#   npx wrangler secret put TURNSTILE_SECRET_KEY --config workers/contact/wrangler.toml
# Locally they go in workers/contact/.dev.vars (git-ignored).

# Required. The inbox that receives notes; a verified Email Routing destination.
CONTACT_TO=

# Optional. Turns on the Turnstile check. Set together with TURNSTILE_SITE_KEY in src/lib/site.ts.
TURNSTILE_SECRET_KEY=

# Local development only, in workers/contact/.dev.vars: "true" lets http://localhost pages post.
# Never set it on the deployed Worker.
ALLOW_LOCAL_ORIGINS=

# --- CI only (GitHub repository secret, not read by the code) ---
# CLOUDFLARE_API_TOKEN — used by deploy-pages.yml (Pages) and deploy-contact-worker.yml (Workers
# Scripts: Edit + custom domains on aitamer.news).

# --- CI only (GitHub repository *variables*, read by workflows, not by the code) ---
# MAINTAINER_ID — optional; the maintainer's numeric GitHub account id (`gh api users/<login> --jq .id`).
# Read by check-publisher-pr.yml: the `publisher-paths` check holds every pull request to
# src/content/comments/<slug>.json unless its author and the event's sender are both this account.
# Unset, empty or not a number: every pull request is held to the rule (CONTRIBUTING.md).
# PUBLISHER_ACTOR_ID — optional; the desk's publisher GitHub App's numeric bot account id
# (`gh api 'users/<app-slug>[bot]' --jq .id`). Read by deploy-pages.yml: a push whose
# github.actor_id is this id must change only comment files, or nothing is deployed.
# Unset or blank: that guard skips with a notice. Set but not a number: the deploy fails.
