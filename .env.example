# Every variable the code reads. Never put a real value in this file.

# --- Build time (astro.config.mjs) ---
# Optional. Absolute site origin used for canonical URLs, RSS, and the sitemap.
# Default: https://aitamer.news. The GitHub Pages workflow sets https://michelabboud.github.io.
ASTRO_SITE=

# Optional. Path prefix the site is served under. Default: /.
# The GitHub Pages workflow sets /aitamer-news.
ASTRO_BASE=

# --- Runtime, Cloudflare Pages Function (functions/api/contact.js) ---
# Set these as Pages secrets, never in the site build:
#   npx wrangler pages secret put CONTACT_TO --project-name=aitamer-news
#   npx wrangler pages secret put CF_EMAIL_API_TOKEN --project-name=aitamer-news
# Locally, put them in .dev.vars (gitignored) for `wrangler pages dev`.

# Required. The inbox that receives notes; a verified Email Routing destination.
CONTACT_TO=

# Required. Cloudflare API token with only "Email Sending: Edit". Not the deploy token.
CF_EMAIL_API_TOKEN=

# Optional. Cloudflare account id for the Email Sending API. Default: the aitamer.news account.
CF_ACCOUNT_ID=

# --- CI only (GitHub repository secret, not read by the code) ---
# CLOUDFLARE_API_TOKEN — used by .github/workflows/deploy-pages.yml to upload to Pages.
