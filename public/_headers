# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Everything under /_astro/ is emitted by the build with a content hash in its file name
# (BaseLayout.<hash>.css, Reactions…<hash>.js), so a changed file always has a new URL: browsers may
# keep these for a year without asking again. Nothing else on the site is named by content, so
# nothing else gets this rule.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Story pages: the browser may reuse one for 30 seconds, then asks again. Short on purpose: a correction
# or a withdrawal must reach a returning reader quickly, and the open-page notice (/rev/<slug>.json) covers a
# tab left open. Only the browser: nothing here lets the edge keep a page, so a new visitor always gets the
# current deployment. The notice's own files live under /rev/ and /latest.json, outside this rule, so they
# keep the default max-age=0 (Pages joins the values of a header that two rules both set).
/posts/*
  Cache-Control: public, max-age=30, must-revalidate
# Preview deployments (<id>.<project>.pages.dev, <branch>.<project>.pages.dev) stay out of search
# results; aitamer.news never matches these, and the deploy's smoke test fails production if it ever
# carries noindex (docs/adr/0014-verified-deploys.md).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
