{
  "name": "aitamer-news",
  "type": "module",
  "version": "0.2.29",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-diagrams.mjs --write dist && pagefind --site dist && node scripts/csp-headers.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"scripts/*.test.mjs\" \"src/lib/*.test.ts\" \"workers/contact/test/*.test.mjs\"",
    "stamp": "node scripts/stamp-post-times.mjs && node scripts/stamp-specimens.mjs",
    "check:times": "node scripts/stamp-post-times.mjs --check",
    "check:dist": "node scripts/check-dist-secrets.mjs",
    "astro": "astro",
    "dev:contact": "npx --yes wrangler@4.139.0 dev --config workers/contact/wrangler.toml",
    "check:specimens": "node scripts/stamp-specimens.mjs --check",
    "check:comments": "node scripts/check-comments.mjs",
    "check:reactions": "node scripts/check-reactions.mjs",
    "check:posts": "node scripts/stamp-post-times.mjs --check && node scripts/stamp-specimens.mjs --check && node scripts/check-comments.mjs && node scripts/check-reactions.mjs && node scripts/check-authors.mjs && node scripts/check-diagrams.mjs && node scripts/check-rendered-body.mjs && node scripts/check-reader-text.mjs",
    "check:bodies": "node scripts/check-rendered-body.mjs",
    "check:bodies:build": "node scripts/check-rendered-body.mjs --against-build",
    "check:files": "node scripts/check-dist-files.mjs",
    "check:links": "node scripts/check-dist-links.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:diagrams:dist": "node scripts/check-diagrams.mjs --check-dist dist",
    "check:csp": "node scripts/csp-headers.mjs --check",
    "check:media": "node scripts/check-media.mjs",
    "post-builder": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/post-builder.mjs",
    "preflight": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bot-preflight.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "js-yaml": "4.3.2",
    "parse5": "8.0.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "description": "AI Tamer news site (aitamer.news) — static Astro on Cloudflare Pages",
  "devDependencies": {
    "pagefind": "1.5.2"
  },
  "license": "Apache-2.0"
}
