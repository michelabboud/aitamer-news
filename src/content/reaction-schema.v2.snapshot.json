{
  "$id": "https://aitamer.news/contract/v2/reactions.schema.json",
  "title": "AI Tamer reactions data file v2",
  "description": "Public v2/reactions/<slug>.json envelope. The generation is a canonical positive signed-64-bit decimal string from 1 to 9223372036854775807, compared with BigInt. Empty reactions is a permanent zero-state barrier. Reaction ids are unique and sorted ascending; retired ids remain valid. The slug equals the object filename and names a story. Bytes are canonical JSON in version, slug, generation, reactions key order, each reaction in id, n order, with one trailing newline; duplicate keys and noncanonical bytes are invalid. The reader retains the last accepted generation through retries, refuses older or changed same-generation payloads, and never falls back to v1.",
  "x-contract-version": 2,
  "x-max-utf8-bytes": 8192,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "slug": {
      "type": "string",
      "maxLength": 120,
      "allOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        }
      ]
    },
    "generation": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0}|9223372036854775807)(?![\\s\\S])"
    },
    "reactions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9-]{0,23}$"
              },
              {
                "pattern": "^[a-z][a-z0-9-]{0,23}(?![\\s\\S])"
              }
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "n"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "slug",
    "generation",
    "reactions"
  ],
  "additionalProperties": false
}
