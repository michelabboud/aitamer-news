{
  "$id": "https://aitamer.news/contract/v1/comments-index.schema.json",
  "title": "AI Tamer comments index",
  "description": "The contract the comments index (v1/comments-index.json in the public data bucket) on aitamer.news satisfies. Generated from the same zod schema a reader validates against, so it cannot drift. It carries public data only: counts of approved comments per story and the newest comments site-wide. Lengths are counted in Unicode code points. Eight rules cannot be expressed here. A reader enforces the first seven; the eighth is the desk's alone, because a reader cannot know which story titles the desk could not find: (1) counts holds only stories with at least one approved comment, and its keys are sorted ascending by UTF-16 code unit (a slug of digits only, such as 2026, is the one case a JavaScript reader cannot see the order of); (2) counts holds at most 10000 stories; (3) recent holds the 60 newest approved comments site-wide at most, newest first by at, comments with the same at ordered by id descending; (4) ids in recent are unique; (5) every slug in recent is a key of counts, and recent holds no more comments of a story than its count; (6) when recent is not empty, generatedAt equals the at of its first entry, so the same state makes the same bytes; (7) a text longer than 400 code points is cut at a grapheme boundary and marked truncated true, so no text is longer than 400 and truncated is never false; (8) an entry whose story title cannot be found is left out of recent. The patterns are ECMA-262 without the u flag, exactly as in the comment contract (/contract/v1/comments.schema.json), whose name, text and slug rules this contract reuses. The format is documented in POST.md: https://github.com/michelabboud/aitamer-news/blob/main/POST.md",
  "x-contract-version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "site": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000
      },
      "maxProperties": 10000
    },
