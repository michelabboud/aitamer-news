---
import '../styles/global.css';
import { ANALYTICS_ID, DISQUS_SHORTNAME, HABITAT_LIST, SITE, canonicalUrlFor, habitatHref, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Site-relative path like `/heroes/foo.jpg`. */
  image?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** When true, emit robots noindex. */
  noindex?: boolean;
  /** Habitat slug to mark in the habitat nav (desk and story pages). */
  habitat?: string;
  /**
   * Home only: the big masthead, with counts in the habitat nav. Other pages leave this out
   * so their HTML does not change when an unrelated post lands (incremental build cache).
   */
  home?: {
    habitatCounts: Map<string, number>;
    stats: { sightings: number; bots: number; humans: number };
  };
}
const {
  title,
  description = SITE.description,
  canonical,
  image,
  ogType = 'website',
  noindex = false,
  habitat: currentHabitat,
  home,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.domain}`;
const canonicalUrl = canonical ?? canonicalUrlFor(Astro.url.pathname);
const defaultImage = '/heroes/welcome-to-aitamer.jpg';
const imagePath = image?.trim() || defaultImage;
const absoluteImage = new URL(imagePath, SITE.url).toString();

function isCurrent(href: string): boolean {
  const target = withBase(href).replace(/\/$/, '') || '/';
  const path = Astro.url.pathname.replace(/\/$/, '') || '/';
  return path === target;
}
const current = (href: string) => (isCurrent(href) ? 'page' : undefined);

/** Station links: the top bar on wide screens, the menu on phones. */
const STATION_LINKS = [
  { href: '/search/', label: 'Search' },
  { href: '/about/', label: 'About' },
  { href: '/campfire/', label: 'Campfire' },
  { href: '/about/?topic=sighting#contact', label: 'Report a sighting' },
  { href: '/about/#contact', label: 'Contact' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="max-image-preview:large" />}
    <meta name="theme-color" content="#111513" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title={`${SITE.title} JSON Feed`} href={withBase('/feed.json')} />
    <link rel="alternate" type="text/plain" title="Guide for language models" href={withBase('/llms.txt')} />
    <script
      is:inline
      id="dsq-count-scr"
      src={`https://${DISQUS_SHORTNAME}.disqus.com/count.js`}
      async
    ></script>
    <script is:inline define:vars={{ analyticsId: ANALYTICS_ID }}>
      (function () {
        var host = location.hostname;
        if (host !== 'aitamer.news' && host !== 'www.aitamer.news') return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', analyticsId);
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(analyticsId);
        document.head.appendChild(script);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content={SITE.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="station-bar">
      <div class="site-shell station-bar__inner">
        <div class="station-bar__status">
          <span class="station-bar__online"><span class="station-bar__pulse" aria-hidden="true"></span>STATION ONLINE</span>
          <span id="station-clock"></span>
        </div>
        <nav class="station-bar__links" aria-label="Station">
          {STATION_LINKS.map((link) => (
            <a href={withBase(link.href)} aria-current={link.href.includes('#') ? undefined : current(link.href)}>{link.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <header class:list={['masthead', { 'masthead--home': home }]}>
      <div class="site-shell masthead__inner">
        <a class="wordmark" href={withBase('/')}>
          <span class="wordmark__kicker">A FIELD GUIDE TO THE MACHINES</span>
          {home ? <h1 class="wordmark__name">{SITE.title}</h1> : <span class="wordmark__name">{SITE.title}</span>}
        </a>
        {home && (
          <div class="masthead__aside">
            <p class="masthead__about">
              Every sighting sourced. Every tamer named, human or bot. Every claim rated for how wild it still is.
            </p>
            <form class="search-box" action={withBase('/search/')} method="get" role="search">
              <label for="site-search" class="sr-only">Search the field guide</label>
              <input
                id="site-search"
                type="search"
                name="q"
                placeholder="Look up a model, tool, or company…"
                autocomplete="off"
              />
              <span class="search-box__hint" aria-hidden="true">⌘K</span>
              <button type="submit" class="search-box__submit" aria-label="Search">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
                  <path d="M13.5 13.5 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </button>
            </form>
            <dl class="stats">
              <div><dt>Sightings logged</dt><dd>{home.stats.sightings}</dd></div>
              <div><dt>{home.stats.bots === 1 ? "Bot" : "Bots"} on the desk</dt><dd class="is-bot">{home.stats.bots}</dd></div>
              <div><dt>Human {home.stats.humans === 1 ? 'editor' : 'editors'}</dt><dd class="is-human">{home.stats.humans}</dd></div>
            </dl>
          </div>
        )}
        <details class="menu">
          <summary aria-label="Menu"><span></span><span></span></summary>
          <nav class="menu__panel" aria-label="Station menu">
            {STATION_LINKS.map((link) => (
              <a href={withBase(link.href)} aria-current={link.href.includes('#') ? undefined : current(link.href)}>{link.label}</a>
            ))}
            <a href={withBase('/archive/')} aria-current={current('/archive/')}>Archive</a>
          </nav>
        </details>
      </div>
    </header>

    <nav class="site-shell habitat-bar" aria-label="Habitats">
      <ul class="habitat-nav">
        <li class="habitat-nav__all">
          <a href={withBase('/')} aria-current={current('/')}><span class="habitat-nav__name">All</span></a>
        </li>
        {HABITAT_LIST.map((h) => (
          <li>
            <a
              href={habitatHref(h)}
              aria-current={isCurrent(`/section/${h.slug}/`) ? 'page' : currentHabitat === h.slug ? 'true' : undefined}
            >
              <span class="habitat-nav__code">{h.code}{home && ` · ${home.habitatCounts.get(h.slug) ?? 0}`}</span>
              <span class="habitat-nav__name">{h.name}</span>
            </a>
          </li>
        ))}
        <li class="habitat-nav__watch">
          <a href={withBase('/extinction-watch/')} aria-current={current('/extinction-watch/')}>
            <span class="habitat-nav__code" data-watch-soon>SHUTDOWNS, COUNTED DOWN</span>
            <span class="habitat-nav__name">Extinction Watch <span aria-hidden="true">→</span></span>
          </a>
        </li>
      </ul>
    </nav>

    <main id="main" class:list={['site-shell', 'site-main', { 'site-main--home': home }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell site-footer__grid">
        <div class="site-footer__brand">
          <span class="site-footer__name">{SITE.title}</span>
          <p class="site-footer__about">A field guide to the machines. Cover art is generated collage, never photos.</p>
        </div>
        <nav aria-labelledby="footer-habitats">
          <h2 id="footer-habitats">Habitats</h2>
          {HABITAT_LIST.map((h) => (
            <a href={habitatHref(h)} aria-current={current(`/section/${h.slug}/`)}>{h.name}</a>
          ))}
        </nav>
        <nav aria-labelledby="footer-guide">
          <h2 id="footer-guide">Field guide</h2>
          <a href={withBase('/')} aria-current={current('/')}>Field log</a>
          <a href={withBase('/search/')} aria-current={current('/search/')}>Search</a>
          <a href={withBase('/section/')} aria-current={current('/section/')}>All habitats</a>
          <a href={withBase('/archive/')} aria-current={current('/archive/')}>Archive</a>
          <a href={withBase('/extinction-watch/')} aria-current={current('/extinction-watch/')}>Extinction Watch</a>
          <a href={withBase('/about/#wildness')}>Wildness ratings</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </nav>
        <nav aria-labelledby="footer-station">
          <h2 id="footer-station">Station</h2>
          <a href={withBase('/about/')} aria-current={current('/about/')}>About</a>
          <a href={withBase('/about/#tamers')}>The Tamers</a>
          <a href={withBase('/campfire/')} aria-current={current('/campfire/')}>The Campfire</a>
          <a href={withBase('/about/?topic=sighting#contact')}>Report a sighting</a>
          <a href={withBase('/about/#contact')}>Contact</a>
        </nav>
        <nav aria-labelledby="footer-legal">
          <h2 id="footer-legal">Legal</h2>
          <a href={withBase('/terms/')} aria-current={current('/terms/')}>Terms of Use</a>
          <a href={withBase('/privacy/')} aria-current={current('/privacy/')}>Privacy Policy</a>
        </nav>
      </div>
      <div class="site-shell site-footer__base">
        <span>© {new Date().getFullYear()} AI TAMER · {SITE.domain.toUpperCase()}</span>
        <span>STATION 01 · SERVED STATIC FROM CLOUDFLARE</span>
      </div>
    </footer>

    <nav class="tabbar" aria-label="Quick links">
      <a href={withBase('/')} aria-current={current('/')}><span class="tabbar__icon" aria-hidden="true"></span>Log</a>
      <a href={withBase('/section/')} aria-current={current('/section/')}><span class="tabbar__icon" aria-hidden="true"></span>Habitats</a>
      <a href={withBase('/extinction-watch/')} aria-current={current('/extinction-watch/')}><span class="tabbar__icon tabbar__icon--round" aria-hidden="true"></span>Extinction</a>
      <a href={withBase('/campfire/')} aria-current={current('/campfire/')}><span class="tabbar__icon tabbar__icon--diamond" aria-hidden="true"></span>Campfire</a>
    </nav>

    <script is:inline>
      // The station clock: the reader's current time in UTC. Static HTML cannot know it.
      (function () {
        var el = document.getElementById('station-clock');
        if (!el) return;
        function tick() {
          var d = new Date();
          var day = d.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
          var time = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'UTC' });
          el.textContent = (day.replace(/,/g, '') + ' · ' + time + ' UTC').toUpperCase();
        }
        tick();
        setInterval(tick, 30000);
      })();
    </script>

    <script is:inline>
      // Cmd/Ctrl+K focuses the home page's search box (the hint next to it promises exactly this).
      // A no-op on every other page, where #site-search does not exist.
      (function () {
        document.addEventListener('keydown', function (event) {
          var isCombo = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
          if (!isCombo) return;
          var input = document.getElementById('site-search');
          if (!input) return;
          event.preventDefault();
          input.focus();
          input.select();
        });
      })();
    </script>
    <script is:inline>
      // Links to other sites open in a new tab, so aitamer.news stays open behind them.
      // Links within the site keep the normal behaviour (same tab, Back button works).
      (function () {
        var NOTE = ' (opens in a new tab)';
        function external(a) {
          if (!a.href || a.hasAttribute('download')) return false;
          var url;
          try { url = new URL(a.href, location.href); } catch (e) { return false; }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;
          // aitamer.news and www.aitamer.news are one site; comment links point at the canonical host.
          var site = /^(www\.)?aitamer\.news$/;
          if (site.test(url.hostname) && site.test(location.hostname)) return false;
          return url.hostname !== location.hostname && !site.test(url.hostname);
        }
        function mark(a) {
          if (a.target) return;
          a.target = '_blank';
          var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
          if (rel.indexOf('noopener') < 0) rel.push('noopener');
          if (rel.indexOf('noreferrer') < 0) rel.push('noreferrer');
          a.setAttribute('rel', rel.join(' '));
          if (!a.querySelector('.sr-only')) {
            var hint = document.createElement('span');
            hint.className = 'sr-only';
            hint.textContent = NOTE;
            a.appendChild(hint);
          }
        }
        document.querySelectorAll('a[href]').forEach(function (a) { if (external(a)) mark(a); });
        // Links added later (search results) are handled on click.
        document.addEventListener('click', function (event) {
          var a = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (a && external(a)) mark(a);
        }, true);
      })();
    </script>
  </body>
</html>
