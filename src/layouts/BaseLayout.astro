---
import '../styles/global.css';
import { SITE, canonicalUrlFor, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Site-relative path like `/heroes/foo.jpg`. */
  image?: string;
  /** Open Graph type. */
  ogType?: 'website' | 'article';
  /** When true, emit robots noindex. */
  noindex?: boolean;
}
const {
  title,
  description = SITE.description,
  canonical,
  image,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.domain}`;
const canonicalUrl = canonical ?? canonicalUrlFor(Astro.url.pathname);
const defaultImage = '/heroes/welcome-to-aitamer.jpg';
const imagePath = image?.trim() || defaultImage;
const absoluteImage = new URL(imagePath, SITE.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fff8f0" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={withBase('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Martian+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content={SITE.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body data-theme="big-top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="brand" href={withBase('/')}>
          <span class="brand__title">{SITE.title}</span>
          <span class="brand__domain">{SITE.domain}</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href={withBase('/')}>Home</a>
          <a href={withBase('/section/top/')}>Sections</a>
          <a href={withBase('/about/')}>About</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>
    <main id="main" class="site-shell site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <p>© {new Date().getFullYear()} {SITE.title} · {SITE.domain}</p>
        <p>
          Human editors + desk bots. Static on Cloudflare Pages.
        </p>
      </div>
    </footer>
  </body>
</html>
