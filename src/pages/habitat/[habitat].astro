---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import {
  HABITATS,
  SECTION_LABELS,
  entryStamp,
  getPostsByHabitat,
  getPublishedPosts,
  getSpecimenNumbers,
  habitatBySlug,
  resolveAuthor,
  sectionHref,
  type Section,
} from '../../lib/site';
import { postCover, coverForSection } from '../../lib/covers';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const numbers = await getSpecimenNumbers();
  const authors = await getCollection('authors');
  const authorById = new Map(authors.map((author) => [author.id, author]));
  return HABITATS.map((habitat) => {
    const stamps = posts
      .filter((post) => habitat.sections.includes(post.data.section))
      .flatMap((post) => {
        const author = authorById.get(post.data.author.id);
        return [entryStamp(post), author ? entryStamp(author) : 'missing-author', `specimen:${numbers.get(post.id)}`];
      })
      .sort();
    return {
      params: { habitat: habitat.slug },
      cacheKey: stamps.join('|'),
    };
  });
}

const habitat = habitatBySlug(Astro.params.habitat ?? '');
if (!habitat) {
  return Astro.redirect('/');
}
const posts = await getPostsByHabitat(habitat);
const numbers = await getSpecimenNumbers();
const cards = await Promise.all(
  posts.map(async (post) => {
    const author = await resolveAuthor(post);
    if (!author) throw new Error(`Missing author for post ${post.id}`);
    return { post, author };
  }),
);
const ogImage = cards[0] ? postCover(cards[0].post) : coverForSection(habitat.sections[0] as Section);
const desks = habitat.sections.length > 1 ? (habitat.sections as Section[]) : [];
---
<BaseLayout
  title={habitat.name}
  description={`AI Tamer sightings in Habitat ${habitat.code}: ${habitat.name}.`}
  image={ogImage}
  habitat={habitat.slug}
>
  <header class="page-head">
    <p class="page-kicker">Habitat {habitat.code} · {cards.length} {cards.length === 1 ? 'sighting' : 'sightings'}</p>
    <h1 class="page-title">{habitat.name}</h1>
    <p class="lede">Every sighting in this habitat, newest first. Each carries its specimen number and wildness rating.</p>
    {desks.length > 0 && (
      <ul class="desk-list" aria-label="Desks in this habitat">
        {desks.map((desk) => (
          <li><a class="tag tag--plain" href={sectionHref(desk)}>{SECTION_LABELS[desk]} desk</a></li>
        ))}
      </ul>
    )}
  </header>

  {cards.length === 0 ? (
    <p class="empty">No sightings in this habitat yet.</p>
  ) : (
    <ul class="cards listing">
      {cards.map(({ post, author }, i) => (
        <li><PostCard post={post} author={author} specimen={numbers.get(post.id)!} heading="h2" showDesc eager={i < 3} /></li>
      ))}
    </ul>
  )}
</BaseLayout>
