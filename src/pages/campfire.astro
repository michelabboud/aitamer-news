---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommentCount from '../components/CommentCount.astro';
import CommentIndexLive from '../components/CommentIndexLive.astro';
import { commentAnchor, commentCountFor, stripInvisible } from '../lib/comment-text';
import {
  AROUND_THE_FIRE_EMPTY_TEXT,
  AROUND_THE_FIRE_MAX,
  AROUND_THE_FIRE_NOSCRIPT_TEXT,
  dataBaseUrl,
  fireExcerpt,
} from '../lib/comments-client';
import {
  COMMENTS_DATA_BASE,
  COMMENTS_SOURCE,
  CONTACT_FORM_LIVE,
  formatShortDate,
  getCommentThreads,
  getPublishedPosts,
  habitatOfPost,
  postHref,
  withBase,
} from '../lib/site';

// "Around the fire" keeps its length and excerpt rules in `src/lib/comments-client.ts`, so the baked
// page and the browser's (`COMMENTS_SOURCE = 'r2'`, from the comments index) cannot drift.
const posts = await getPublishedPosts();
const liveComments = COMMENTS_SOURCE === 'r2';
// Looked up once for every row's count, not once per row; the comments index replaces it when live.
const threads = liveComments ? new Map() : await getCommentThreads();
const commentsDataBase = liveComments ? dataBaseUrl(COMMENTS_DATA_BASE).href : undefined;
const postsById = new Map(posts.map((post) => [post.id, post]));

/**
 * Every approved comment on a published, non-withdrawn story — the only ones with a live comment
 * section to link to — newest first, capped at AROUND_THE_FIRE_MAX. A thread whose post is
 * withdrawn or not yet published (its data file exists but its page does not) is left out.
 */
const recentComments = [...threads.values()]
  .flatMap((thread) => {
    const post = postsById.get(thread.id);
    return post ? thread.data.comments.map((comment) => ({ post, comment })) : [];
  })
  .sort((a, b) => Date.parse(b.comment.at) - Date.parse(a.comment.at))
  .slice(0, AROUND_THE_FIRE_MAX);
---
<BaseLayout
  title="The Campfire"
  description="Where readers talk about the stories. Every AI Tamer story has its own comment thread."
>
  <header class="page-head">
    <p class="page-kicker">Station · comments</p>
    <h1 class="page-title">The Campfire</h1>
    <p class="lede">
      Every story has its own thread under the article. Pull up a log: pick a story below and join
      in.{' '}
      {CONTACT_FORM_LIVE ? (
        <>For a correction or a tip that should reach the desk, use the <a href={withBase('/about/#contact')}>contact form</a> instead.</>
      ) : (
        'For a correction or a tip that should reach the desk, the contact form on the About page opens soon.'
      )}
    </p>
  </header>

  <section aria-labelledby="threads-title" style="max-width: 60rem">
    <div class="rule-head">
      <h2 id="threads-title">Threads, newest story first</h2>
      <span class="mono muted">Comments</span>
    </div>
    <ol class="log">
      {posts.map((post) => (
        <li class="log-row log-row--thread">
          <time class="log-row__time" datetime={post.data.pubDate.toISOString()}>{formatShortDate(post.data.pubDate)}</time>
          <div class="log-row__body">
            <a class="log-row__title" href={`${postHref(post)}#comments`}>{post.data.title}</a>
            <span class="log-row__meta muted">{habitatOfPost(post).name.toUpperCase()}</span>
          </div>
          <CommentCount id={post.id} count={liveComments ? undefined : commentCountFor(threads, post.id)} />
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="around-fire-title" style="max-width: 60rem; margin-top: 3rem">
    <div class="rule-head">
      <h2 id="around-fire-title">Around the fire</h2>
      <span class="mono muted">Newest comments</span>
    </div>
    {liveComments ? (
      <div data-around-fire>
        <p class="muted comments__status"><noscript>{AROUND_THE_FIRE_NOSCRIPT_TEXT}</noscript></p>
      </div>
    ) : recentComments.length === 0 ? (
      <p class="muted" style="max-width: 60ch">{AROUND_THE_FIRE_EMPTY_TEXT}</p>
    ) : (
      <ol class="log">
        {recentComments.map(({ post, comment }) => (
          <li class="log-row log-row--comment">
            <time class="log-row__time" datetime={comment.at}>{formatShortDate(new Date(comment.at))}</time>
            <div class="log-row__body">
              <a class="log-row__title" href={`${postHref(post)}#${commentAnchor(comment.id)}`}>
                <span class="log-row__name" dir="auto">{stripInvisible(comment.name)}</span> on {post.data.title}
              </a>
              <p class="log-row__excerpt" dir="auto">{fireExcerpt(comment.text)}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
    {commentsDataBase && <CommentIndexLive dataBase={commentsDataBase} />}
  </section>

  <p class="muted" style="margin-top: 2rem; max-width: 60ch; font-size: 0.9375rem">
    Posting a comment sends it to comments.aitamer.news. The <a href={withBase('/privacy/')}>privacy page</a> says
    what that sends.
  </p>
</BaseLayout>
