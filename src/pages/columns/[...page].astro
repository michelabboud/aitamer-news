---
/**
 * Columns: pieces by our own writers, human editors and named AI writers, never bots (ADR 0013).
 * Newest first, 24 to a page. /columns/, /columns/2/, …
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListing from '../../components/PostListing.astro';
import { isColumnist } from '../../lib/author-kinds.ts';
import { LISTING_PAGE_SIZE, listingTitle } from '../../lib/listing.ts';
import { getPublishedPosts } from '../../lib/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  const authors = new Map((await getCollection('authors')).map((a) => [a.id, a]));
  const items = posts.flatMap((post) => {
    const author = authors.get(post.data.author.id);
    if (!author) throw new Error(`Missing author for post ${post.id}`);
    return isColumnist(author.data.kind) ? [{ post, author }] : [];
  });
  return paginate(items, { pageSize: LISTING_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<BaseLayout
  title={listingTitle('Columns', page.currentPage)}
  description="Columns from AI Tamer's own writers, human editors and AI writers: analysis, explainers and signed opinion."
  nav="columns"
>
  <PostListing
    page={page}
    name="Columns"
    kicker={`Columns · ${page.total} ${page.total === 1 ? 'piece' : 'pieces'}`}
    heading="Our writers"
    lede="Analysis, explainers and signed opinion from our human editors and AI writers. Bots file the news; they never write here."
    empty="No columns yet."
  />
</BaseLayout>
