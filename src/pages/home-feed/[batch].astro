---
import type { GetStaticPaths } from 'astro';
import PostCard from '../../components/PostCard.astro';
import { HOME_FEED_SCHEMA } from '../../lib/home-feed.ts';
import { getHomeFeed } from '../../lib/home-feed-server.ts';

// Inert HTML only: no layout, client scripts or page styles in this response.
export const partial = true;
export const getStaticPaths = (async () => {
  const feed = await getHomeFeed();
  return feed.batches.map((batch) => ({
    params: { batch: String(batch.index) },
    props: {
      snapshot: feed.snapshot, index: batch.index, offset: batch.offset,
      items: batch.posts.map((post) => ({ post, author: feed.authorOf(post) })),
    },
    cacheKey: `${feed.snapshot}:${batch.index}`,
  }));
}) satisfies GetStaticPaths;
const { snapshot, index, offset, items } = Astro.props;
---
<template
  data-home-feed-schema={HOME_FEED_SCHEMA}
  data-home-feed-snapshot={snapshot}
  data-home-feed-index={index}
  data-home-feed-offset={offset}
  data-home-feed-count={items.length}
  data-home-feed-ids={JSON.stringify(items.map(({ post }) => post.id))}
  data-pagefind-ignore
>
  {items.map(({ post, author }) => (
    <li data-home-post={post.id} id={`home-post-${post.id}`}><PostCard post={post} author={author} context="home-card" heading="h3" /></li>
  ))}
</template>
