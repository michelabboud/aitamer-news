---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorBadge from '../../components/AuthorBadge.astro';
import { entryStamp, getPostsByAuthor, getPublishedPosts, getSpecimenNumbers, resolveAuthor, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const posts = await getPublishedPosts();
  const numbers = await getSpecimenNumbers();
  return authors.map((author) => {
    const stamps = [
      entryStamp(author),
      ...posts
        .filter((post) => post.data.author.id === author.id)
        .map((post) => `${entryStamp(post)}#${numbers.get(post.id)}`)
        .sort(),
    ];
    return {
      params: { id: author.id },
      props: { author },
      cacheKey: stamps.join('|'),
    };
  });
}

const { author } = Astro.props;
const posts = await getPostsByAuthor(author.id);
const numbers = await getSpecimenNumbers();
const initials = author.data.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const cards = await Promise.all(
  posts.map(async (post) => {
    const resolved = await resolveAuthor(post);
    if (!resolved) throw new Error(`Missing author for post ${post.id}`);
    return { post, author: resolved };
  }),
);
---
<BaseLayout title={author.data.name} description={author.data.bio} image={author.data.avatar ?? '/heroes/welcome-to-aitamer.jpg'}>
  <header class="page-head">
    <p class="page-kicker">The Tamers · {cards.length} {cards.length === 1 ? 'sighting' : 'sightings'} filed</p>
    <h1 class="page-title">{author.data.name}</h1>
  </header>
  <div class="author-card">
    {author.data.avatar ? (
      <img class="tamer__avatar" src={withBase(author.data.avatar)} alt="" width="52" height="52" />
    ) : (
      <span class={`tamer__avatar tamer__avatar--${author.data.kind}`} aria-hidden="true">{initials}</span>
    )}
    <div class="author-card__text">
      <span><AuthorBadge kind={author.data.kind} name={author.data.kind === 'bot' ? 'News bot' : 'Human editor'} /></span>
      <p>{author.data.bio}</p>
    </div>
  </div>

  <h2 class="rule-head" style="font-size: 32px; margin-bottom: 22px">Sightings filed</h2>
  {cards.length === 0 ? (
    <p class="empty">No published sightings yet.</p>
  ) : (
    <ul class="cards listing">
      {cards.map(({ post, author: a }, i) => (
        <li><PostCard post={post} author={a} specimen={numbers.get(post.id)!} heading="h3" showDesc eager={i < 3} /></li>
      ))}
    </ul>
  )}
</BaseLayout>
