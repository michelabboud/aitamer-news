---
import { getCollection } from 'astro:content';
import { isFeaturedWriter, splitPoems, writerAuthorPath, writerNoun } from '../../lib/writer-pages.ts';
import { jsonLdAuthorType } from '../../lib/author-kinds.ts';
import { toJsonLd } from '../../lib/json-ld';
import WriterProfile from '../../components/WriterProfile.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, canonicalUrlFor, entryStamp, getPostsByAuthor, getPublishedPosts, resolveAuthor, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const posts = await getPublishedPosts();
  return authors.map((author) => {
    const stamps = [
      entryStamp(author),
      ...posts
        .filter((post) => post.data.author.id === author.id)
        .map(entryStamp)
        .sort(),
    ];
    return {
      params: { id: author.id },
      props: { author },
      cacheKey: stamps.join('|'),
    };
  });
}

const { author } = Astro.props;
const featured = isFeaturedWriter(author);
const { name, kind, bio, portrait } = author.data;
const image = featured ? portrait : author.data.avatar;
const pageUrl = canonicalUrlFor(writerAuthorPath(author));
const posts = await getPostsByAuthor(author.id);
const [poems, pieces] = splitPoems(posts);
const cards = await Promise.all(
  posts.map(async (post) => {
    const resolved = await resolveAuthor(post);
    if (!resolved) throw new Error(`Missing author for post ${post.id}`);
    return { post, author: resolved };
  }),
);
---
<BaseLayout title={name} description={bio} image={image}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: pageUrl,
      mainEntity: {
        '@type': jsonLdAuthorType(kind),
        name,
        description: `${name} is ${writerNoun(author)} at ${SITE.title}. ${bio}`,
        url: pageUrl,
        ...(image ? { image: canonicalUrlFor(image) } : {}),
      },
    })}
  />
  <WriterProfile author={author} count={posts.length} poemCount={poems.length} pieceCount={pieces.length} imageSrc={image ? withBase(image) : undefined}>
    <ul slot="poems" class="cards listing">
      {poems.map((post, i) => (
        <li><PostCard post={post} author={author} heading="h3" showDesc eager={i < 3} /></li>
      ))}
    </ul>
    <ul slot="pieces" class="cards listing">
      {pieces.map((post, i) => (
        <li><PostCard post={post} author={author} heading="h3" showDesc eager={poems.length === 0 && i < 3} /></li>
      ))}
    </ul>
    <ul slot="sightings" class="cards listing">
      {cards.map(({ post, author: a }, i) => (
        <li><PostCard post={post} author={a} heading="h3" showDesc eager={i < 3} /></li>
      ))}
    </ul>
  </WriterProfile>
</BaseLayout>
