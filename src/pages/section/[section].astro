---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { LEGACY_SECTIONS, isLegacySection } from '../../lib/habitats';
import { redirectStubHtml } from '../../lib/redirect-stub';
import {
  ALL_SECTIONS,
  SECTION_LABELS,
  canonicalUrlFor,
  sectionHref,
  entryStamp,
  getPostsBySection,
  getPublishedPosts,
  isSection,
  resolveAuthor,
  type Section,
} from '../../lib/site';
import { postCover, coverForSection } from '../../lib/covers';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const authors = await getCollection('authors');
  const authorById = new Map(authors.map((author) => [author.id, author]));
  // Retired desks get a redirect page at their old URL; the cache key is the target only.
  const legacy = Object.entries(LEGACY_SECTIONS).map(([section, target]) => ({
    params: { section },
    cacheKey: `legacy:${target}`,
  }));
  const habitats = ALL_SECTIONS.map((section) => {
    const stamps = posts
      .filter((post) => post.data.section === section)
      .flatMap((post) => {
        const author = authorById.get(post.data.author.id);
        return [entryStamp(post), author ? entryStamp(author) : 'missing-author'];
      })
      .sort();
    return {
      params: { section },
      cacheKey: stamps.join('|'),
    };
  });
  return [...habitats, ...legacy];
}

const raw = Astro.params.section ?? '';
const legacyTarget = isLegacySection(raw) ? LEGACY_SECTIONS[raw] : null;
const stub = legacyTarget
  ? redirectStubHtml({
      to: sectionHref(legacyTarget),
      canonical: canonicalUrlFor(`/section/${legacyTarget}/`),
      label: SECTION_LABELS[legacyTarget],
    })
  : null;
if (!stub && !isSection(raw)) throw new Error(`Unknown section ${raw}`);
const section = (legacyTarget ?? raw) as Section;
const posts = await getPostsBySection(section);
const cards = await Promise.all(
  posts.map(async (post) => {
    const author = await resolveAuthor(post);
    if (!author) throw new Error(`Missing author for post ${post.id}`);
    return { post, author };
  }),
);
const ogImage = cards[0] ? postCover(cards[0].post) : coverForSection(section);
---
{stub ? <Fragment set:html={stub} /> : (
<BaseLayout
  title={SECTION_LABELS[section]}
  description={`AI Tamer stories in ${SECTION_LABELS[section]}.`}
  image={ogImage}
>
  <div data-section={section}>
    <p class="page-kicker">Section</p>
    <h1 class="page-title">{SECTION_LABELS[section]}</h1>
    <p class="lede">Published stories filed under {SECTION_LABELS[section]}.</p>

    {cards.length === 0 ? (
      <p class="empty">No published posts in this section yet.</p>
    ) : (
      <div class="post-list">
        {cards.map(({ post, author }, i) => (
          <PostCard post={post} author={author} feature={i === 0} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
)}
