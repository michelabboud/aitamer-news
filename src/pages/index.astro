---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionChip from '../components/SectionChip.astro';
import {
  ALL_SECTIONS,
  SITE,
  getPublishedPosts,
  resolveAuthor,
} from '../lib/site';
import { postCover } from '../lib/covers';

const posts = await getPublishedPosts();
const cards = await Promise.all(
  posts.map(async (post) => {
    const author = await resolveAuthor(post);
    if (!author) throw new Error(`Missing author for post ${post.id}`);
    return { post, author };
  }),
);
const ogImage = cards[0] ? postCover(cards[0].post) : '/heroes/welcome-to-aitamer.jpg';
---
<BaseLayout title="Latest" description={SITE.description} image={ogImage}>
  <section class="hero" aria-label="Site introduction">
    <div class="hero-plane">
      <p class="page-kicker">Short, sourced AI briefs</p>
      <h1 class="page-title">{SITE.title}</h1>
      <p class="lede">
        Concise reporting on models, tools, policy, and opinion — with clear human and bot bylines. Published static from Markdown.
      </p>
    </div>
  </section>

  <div class="section-chips" aria-label="Sections">
    {ALL_SECTIONS.map((section) => <SectionChip section={section} />)}
  </div>

  <section aria-label="Latest posts">
    <div class="post-list">
      {cards.map(({ post, author }, i) => (
        <PostCard post={post} author={author} feature={i === 0} />
      ))}
    </div>
  </section>
</BaseLayout>
