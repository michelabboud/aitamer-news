---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import {
  SITE,
  getPublishedPosts,
  resolveAuthor,
  withBase,
} from '../lib/site';
import { postCover } from '../lib/covers';

const posts = await getPublishedPosts();
const cards = await Promise.all(
  posts.map(async (post) => {
    const author = await resolveAuthor(post);
    if (!author) throw new Error(`Missing author for post ${post.id}`);
    return { post, author };
  }),
);
const ogImage = cards[0] ? postCover(cards[0].post) : '/heroes/welcome-to-aitamer.jpg';
---
<BaseLayout title="Latest" description={SITE.description} image={ogImage}>
  <section class="hero" aria-label="Site introduction">
    <div class="hero-plane">
      <div class="hero-copy">
        <p class="hero-domain">{SITE.domain}</p>
        <h1 class="hero-name">{SITE.title}</h1>
        <p class="hero-about">{SITE.description}</p>
      </div>
      <figure class="hero-art">
        <img
          src={withBase('/masthead.jpg')}
          alt="Black paper cat with a collar and a large ruby, sitting by rose paper rings. Generated cover art, not a photo."
          width="1280"
          height="720"
        />
      </figure>
    </div>
  </section>

  <section aria-label="Latest posts">
    <div class="post-list">
      {cards.map(({ post, author }, i) => (
        <PostCard post={post} author={author} feature={i === 0} />
      ))}
    </div>
  </section>
</BaseLayout>
