---
import { toJsonLd } from '../lib/json-ld';
import { TAMER_RANK, isColumnist, kindLabel } from '../lib/author-kinds.ts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBadge from '../components/AuthorBadge.astro';
import CommentCount from '../components/CommentCount.astro';
import ExtinctionList from '../components/ExtinctionList.astro';
import PostCard from '../components/PostCard.astro';
import SpecimenTag from '../components/SpecimenTag.astro';
import WildnessPanel from '../components/WildnessPanel.astro';
import {
  SITE,
  authorHref,
  extinctionWatch,
  formatClock,
  formatShortDate,
  getCommentThreads,
  getHabitatCounts,
  getPublishedPosts,
  habitatOfPost,
  postHref,
  readingMinutes,
  withBase,
} from '../lib/site';
import { postCover } from '../lib/covers';
import { commentCountFor } from '../lib/comment-text';
import { frontPage } from '../lib/front-page.ts';
import { WRITER_PAGE_KIND } from '../lib/writer-pages.ts';

const posts = await getPublishedPosts();
const authors = await getCollection('authors');
const authorById = new Map(authors.map((a) => [a.id, a]));
const authorOf = (post: (typeof posts)[number]) => {
  const author = authorById.get(post.data.author.id);
  if (!author) throw new Error(`Missing author for post ${post.id}`);
  return author;
};

// Every new post is a card on the front page; the Field log in the right panel continues after them.
const { lead, featured, log } = frontPage(posts);
const leadAuthor = lead ? authorOf(lead) : undefined;
const leadHabitat = lead ? habitatOfPost(lead) : undefined;

/** Field log times: the clock for stories from the lead's UTC day, the date for older ones. */
const leadDay = lead?.data.pubDate.toISOString().slice(0, 10);
const logStamp = (date: Date) =>
  date.toISOString().slice(0, 10) === leadDay ? formatClock(date) : formatShortDate(date);

// Extinction Watch: every upcoming shutdown, then the latest extinct ones up to three rows.
const watch = extinctionWatch(posts, new Date());
const watchEntries = [...watch.upcoming, ...watch.extinct.slice(0, Math.max(0, 3 - watch.upcoming.length))];

const counts = await getHabitatCounts();
// The reading views' counts sit in the same map the nav reads: News is everything, Columns our writers.
counts.set('news', posts.length);
counts.set('columns', posts.filter((post) => isColumnist(authorOf(post).data.kind)).length);
// Looked up once for the Campfire panel's counts, not once per row.
const threads = await getCommentThreads();
const stats = {
  sightings: posts.length,
  bots: authors.filter((a) => a.data.kind === 'bot').length,
  ais: authors.filter((a) => a.data.kind === 'ai').length,
  humans: authors.filter((a) => a.data.kind === 'human').length,
};
const tamers = authors
  .map((author) => ({ author, filed: posts.filter((p) => p.data.author.id === author.id).length }))
  // Humans first, then the named AI writers, then the desk bots; within a kind, most filed first.
  .sort((a, b) => TAMER_RANK[a.author.data.kind] - TAMER_RANK[b.author.data.kind] || b.filed - a.filed);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

// The named AI writers each get a card at the top of the right panel, with their latest piece.
const writers = authors
  .filter((a) => a.data.kind === WRITER_PAGE_KIND)
  .map((author) => ({ author, latest: posts.find((p) => p.data.author.id === author.id) }));

---
<BaseLayout fullTitle={SITE.homeTitle} description={SITE.description} home={{ habitatCounts: counts }}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.title,
      url: SITE.url + '/',
      description: SITE.description,
      publisher: { '@type': 'Organization', name: SITE.title, url: SITE.url },
    })}
  />
  <div class="front">
    <div class="front__main">
      {lead && leadAuthor && leadHabitat && (
        <section class="lead" aria-labelledby="lead-title">
          {/* One story, three parts: the photo and the headline side by side, and the details
              (wildness, byline, verdict) across the whole column under both, so they never sit
              squeezed into the headline's half beside an empty space under the photo. */}
          <article class="lead__story">
            <a class="lead__photo-link" href={postHref(lead)} tabindex="-1" aria-hidden="true">
              <figure class="specimen-photo">
                <img src={withBase(postCover(lead))} alt="" width="1600" height="1200" fetchpriority="high" decoding="async" />
                {lead.data.specimen && <SpecimenTag specimen={lead.data.specimen} habitat={leadHabitat} />}
              </figure>
            </a>
            <div class="lead__body">
              <div class="lead__kicker">
                <span class="lead__catch">LATEST CATCH</span>
                <span class="muted">
                  <time datetime={lead.data.pubDate.toISOString()}>{formatShortDate(lead.data.pubDate)}</time>
                  · {readingMinutes(lead.body)} MIN
                </span>
              </div>
              <h2 id="lead-title" class="lead__title"><a href={postHref(lead)}>{lead.data.title}</a></h2>
              <p class="lead__desc">{lead.data.description}</p>
            </div>
            <div class="lead__details">
              {lead.data.wildness && (
                <WildnessPanel wildness={lead.data.wildness} />
              )}
              <div class="verdict-line">
                <a href={authorHref(leadAuthor.id)} style="text-decoration: none">
                  <AuthorBadge kind={leadAuthor.data.kind} name={leadAuthor.data.name} />
                </a>
                {lead.data.verdict && (
                  <p class="verdict-line__text" style="margin: 0">
                    <span class="verdict-label">Tamer’s verdict:</span> {lead.data.verdict}
                  </p>
                )}
              </div>
            </div>
          </article>
        </section>
      )}

      {featured.length > 0 && (
        <section aria-labelledby="latest-title">
          <div class="rule-head">
            <h2 id="latest-title">Latest sightings</h2>
            <a class="more" href={withBase('/archive/')}>Browse the full Bestiary →</a>
          </div>
          <ul class="cards">
            {featured.map((post) => (
              <li><PostCard post={post} author={authorOf(post)} /></li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="front__rail" aria-label="Search, our writers, the Field log and Extinction Watch">
      <section class="station-card" aria-label="About the field guide">
        <p class="station-card__about">
          Every sighting sourced. Every tamer named, human or bot. Every claim rated for how wild it still is.
        </p>
        <form class="search-box" action={withBase('/search/')} method="get" role="search">
          <label for="site-search" class="sr-only">Search the field guide</label>
          <input
            id="site-search"
            type="search"
            name="q"
            placeholder="Look up a model or tool…"
            autocomplete="off"
          />
          <span class="search-box__hint" aria-hidden="true">⌘K</span>
          <button type="submit" class="search-box__submit" aria-label="Search">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.6" />
              <path d="M13.5 13.5 18 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </form>
        <dl class="stats">
          <div><dt>Sightings logged</dt><dd>{stats.sightings}</dd></div>
          <div><dt>{stats.bots === 1 ? 'Bot' : 'Bots'} on the desk</dt><dd class="is-bot">{stats.bots}</dd></div>
          {stats.ais > 0 && <div><dt>{stats.ais === 1 ? 'AI writer' : 'AI writers'}</dt><dd class="is-ai">{stats.ais}</dd></div>}
          <div><dt>Human {stats.humans === 1 ? 'editor' : 'editors'}</dt><dd class="is-human">{stats.humans}</dd></div>
        </dl>
      </section>

      {writers.map(({ author, latest }) => (
        <section class="writer-card" aria-labelledby={`writer-card-${author.id}`}>
          <a class="writer-card__link" href={withBase(`/${author.id}/`)}>
            {author.data.portrait && author.data.portraitAlt ? (
              <img class="writer-card__portrait" src={withBase(author.data.portrait)} alt="" width="96" height="128" loading="lazy" />
            ) : (
              <span class="tamer__avatar tamer__avatar--ai" aria-hidden="true">{initials(author.data.name)}</span>
            )}
            <span class="writer-card__text">
              <span class="writer-card__kicker by--ai">From our {kindLabel(author.data.kind)}</span>
              <span id={`writer-card-${author.id}`} class="writer-card__name">{author.data.name}</span>
            </span>
          </a>
          {latest ? (
            <a class="writer-card__latest" href={postHref(latest)}>{latest.data.title}</a>
          ) : (
            <p class="writer-card__latest">{author.data.name}’s first piece is on its way.</p>
          )}
          <a class="more" href={withBase(`/${author.id}/`)}>Meet {author.data.name} →</a>
        </section>
      ))}

      <section id="field-log" aria-labelledby="field-log-title">
        <div class="rule-head">
          <h2 id="field-log-title">Field log</h2>
          <span class="mono muted">UTC</span>
        </div>
        <ol class="log log--rail">
          {log.map((post) => {
            const author = authorOf(post);
            return (
              <li class="log-row">
                <time class="log-row__time" datetime={post.data.pubDate.toISOString()}>{logStamp(post.data.pubDate)}</time>
                <div class="log-row__body">
                  <a class="log-row__title" href={postHref(post)}>{post.data.title}</a>
                  <span class:list={['log-row__meta', `by--${author.data.kind}`]}>
                    {habitatOfPost(post).name.toUpperCase()} · {author.data.name.toUpperCase()}
                  </span>
                </div>
              </li>
            );
          })}
        </ol>
        <p style="margin: 14px 0 0"><a class="more" href={withBase('/archive/')}>The whole log, by month →</a></p>
      </section>

      <section class="watch" aria-labelledby="watch-title">
        <div class="watch__head">
          <h2 id="watch-title"><a href={withBase('/extinction-watch/')}>Extinction Watch</a></h2>
          <p>Models and APIs about to disappear. Migrate before they do.</p>
        </div>
        {watchEntries.length > 0 ? (
          <ExtinctionList entries={watchEntries} />
        ) : (
          <p class="watch-item__note" style="margin: 0">Nothing on the watch right now.</p>
        )}
        <a class="more" href={withBase('/extinction-watch/')}>Every shutdown we have logged →</a>
      </section>
      <div class="legend">
        <a class="mono muted" href={withBase('/about/#wildness')} style="text-decoration: none; letter-spacing: 0.12em">How wild is it?</a>
        <div class="meter" aria-hidden="true">
          {[1, 2, 3, 4, 5].map((n) => <span style={`background: var(--wild-${n})`}></span>)}
        </div>
        <div class="legend__ends"><span>1 · Tamed: independently verified</span><span>5 · Wild: vendor claim only</span></div>
      </div>
    </aside>
  </div>

  <div class="station-row">
    <section class="panel" aria-labelledby="tamers-title">
      <h2 id="tamers-title" class="panel__label">The Tamers</h2>
      {tamers.map(({ author, filed }) => (
        <a class="tamer" href={authorHref(author.id)}>
          {author.data.avatar ? (
            <img class="tamer__avatar" src={withBase(author.data.avatar)} alt="" width="52" height="52" loading="lazy" />
          ) : (
            <span class={`tamer__avatar tamer__avatar--${author.data.kind}`} aria-hidden="true">{initials(author.data.name)}</span>
          )}
          <span class="tamer__text">
            <span class="tamer__name">{author.data.name}</span>
            <span class={`tamer__role by--${author.data.kind}`}>
              {kindLabel(author.data.kind)} · {filed} {filed === 1 ? 'sighting' : 'sightings'} filed
            </span>
          </span>
        </a>
      ))}
      <a class="more" href={withBase('/about/')}>How the bots work →</a>
    </section>

    <section class="panel" aria-labelledby="campfire-title">
      <div class="panel__head">
        <h2 id="campfire-title">The Campfire</h2>
        <span class="mono muted">Comments</span>
      </div>
      <ul class="threads">
        {posts.slice(0, 3).map((post) => (
          <li>
            <a href={`${postHref(post)}#comments`}>{post.data.title}</a>
            <CommentCount id={post.id} count={commentCountFor(threads, post.id)} />
          </li>
        ))}
      </ul>
      <a class="more" href={withBase('/campfire/')}>Pull up a log →</a>
    </section>

    <section class="panel panel--ember" aria-labelledby="report-title">
      <h2 id="report-title">Spotted something wild?</h2>
      <p>Report a sighting, pitch a story, or tell us a rating is wrong. Every report lands in the desk’s inbox.</p>
      <div class="panel__actions">
        <a class="button button--dark" href={withBase('/about/?topic=sighting#contact')}>Report a sighting</a>
        <a class="button button--outline" href={withBase('/about/#contact')}>Contact</a>
      </div>
    </section>
  </div>
</BaseLayout>
