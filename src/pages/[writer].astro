---
/** Static fallback for the five historical writer aliases; Pages serves the generated 301 first. */
import { readFileSync, readdirSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { reservedTopLevelNames, writerAuthorPath, writerPageIds } from '../lib/writer-pages.ts';
import { redirectStubHtml } from '../lib/redirect-stub';
import { canonicalUrlFor, withBase } from '../lib/site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const reserved = reservedTopLevelNames(readdirSync('src/pages'), readdirSync('public'), readFileSync('public/_redirects', 'utf8'));
  const ids = new Set(writerPageIds(authors, reserved));
  return authors.filter((author) => ids.has(author.id)).map((author) => ({
    params: { writer: author.id },
    props: { author },
    cacheKey: `canonical-author:${author.id}:${author.data.name}`,
  }));
}
const { author } = Astro.props;
const path = writerAuthorPath(author);
const stub = redirectStubHtml({ to: withBase(path), canonical: canonicalUrlFor(path), label: author.data.name });
---
<Fragment set:html={stub} />
