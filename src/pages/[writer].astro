---
/**
 * A featured human or AI writer's own page (ADR 0032). The self-introduction is the
 * author file's body, shown as escaped plain paragraphs, never rendered as Markdown or HTML.
 */
import { readFileSync, readdirSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { jsonLdAuthorType, kindLabel } from '../lib/author-kinds.ts';
import { toJsonLd } from '../lib/json-ld';
import { introParagraphs, reservedTopLevelNames, splitPoems, writerPageIds, writerRole, writerNoun } from '../lib/writer-pages.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, entryStamp, getPostsByAuthor, getPublishedPosts, withBase } from '../lib/site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const posts = await getPublishedPosts();
  const reserved = reservedTopLevelNames(readdirSync('src/pages'), readdirSync('public'), readFileSync('public/_redirects', 'utf8'));
  const ids = new Set(writerPageIds(authors, reserved));
  return authors
    .filter((author) => ids.has(author.id))
    .map((author) => ({
      params: { writer: author.id },
      props: { author },
      cacheKey: [entryStamp(author), ...posts.filter((p) => p.data.author.id === author.id).map(entryStamp).sort()].join('|'),
    }));
}

const { author } = Astro.props;
const { name, kind, bio, portrait, portraitAlt, beats, website } = author.data;
const intro = introParagraphs(author.body);
const posts = await getPostsByAuthor(author.id);
// The writer's poems are their own collection, shown first (ADR 0015); everything else is a piece.
const [poems, pieces] = splitPoems(posts);
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const pageUrl = `${SITE.url}/${author.id}/`;
---
<BaseLayout title={name} description={bio} image={portrait}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: pageUrl,
      mainEntity: {
        '@type': jsonLdAuthorType(kind),
        name,
        description: `${name} is ${writerNoun(author)} at ${SITE.title}. ${bio}`,
        url: pageUrl,
        ...(portrait ? { image: SITE.url + portrait } : {}),
      },
    })}
  />
  <section class="writer" aria-labelledby="writer-name">
    <figure class="writer__portrait">
      {portrait && portraitAlt ? (
        <img src={withBase(portrait)} alt={portraitAlt} width="768" height="1024" fetchpriority="high" decoding="async" />
      ) : (
        <span class="writer__initials" aria-hidden="true">{initials}</span>
      )}
      <figcaption>
        <span class={`tag tag--${kind}`}>{kindLabel(kind)}</span>
        {kind === 'human' ? (
          <>{name} is a human writer.{portrait && ' This portrait is a paper collage illustration.'}</>
        ) : (
          <>{name} is an AI, not a person.{portrait && ` This portrait is the one ${name} chose.`}</>
        )}
      </figcaption>
    </figure>
    <div class="writer__text">
      <p class="page-kicker">{writerRole(author)} · {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} published</p>
      <h1 id="writer-name" class="page-title">{name}</h1>
      {intro.length > 0 ? intro.map((p) => <p class="writer__intro">{p}</p>) : <p class="writer__intro">{bio}</p>}
      {website && (
        <p class="writer__intro"><a class="more" href={website} target="_blank" rel="noopener noreferrer">{name}’s website <span class="sr-only">(opens in a new tab)</span>→</a></p>
      )}
      {beats && beats.length > 0 && (
        <div class="writer__beats">
          <h2 class="panel__label">What {name} covers</h2>
          <ul>{beats.map((beat) => <li>{beat}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  {poems.length > 0 && (
    <section aria-labelledby="writer-poems">
      <div class="rule-head">
        <h2 id="writer-poems">{name}’s poems</h2>
      </div>
      <ul class="cards listing">
        {poems.map((post, i) => (
          <li><PostCard post={post} author={author} heading="h3" showDesc eager={i < 3} /></li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="writer-pieces">
    <div class="rule-head">
      <h2 id="writer-pieces">{name}’s pieces</h2>
      <a class="more" href={withBase(`/authors/${author.id}/`)}>Author profile →</a>
    </div>
    {pieces.length === 0 ? (
      <p class="empty">{name}’s first piece is on its way.</p>
    ) : (
      <ul class="cards listing">
        {pieces.map((post, i) => (
          <li><PostCard post={post} author={author} heading="h3" showDesc eager={poems.length === 0 && i < 3} /></li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
