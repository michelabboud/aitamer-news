---
import { SECTION_LABELS, sectionHref, type Section } from '../lib/site';

interface Props {
  section: Section;
  active?: boolean;
}
const { section, active = false } = Astro.props;
---
<a
  class:list={['chip', { 'is-active': active }]}
  href={sectionHref(section)}
  data-section={section}
>
  <span class="chip__dot" aria-hidden="true"></span>
  {SECTION_LABELS[section]}
</a>
