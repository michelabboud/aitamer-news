---
/**
 * One "Share" button that opens a small menu of ways to share the story, shown at the top of the
 * story (in the byline) and again at the end (2026-10-02).
 *
 * It is a `<details>` menu, so it opens and works with no script: the items are plain intent
 * URLs (`src/lib/share.ts`). The bundled script below adds what the links cannot do: closing the
 * menu on an outside click or Escape, a "Copy link" item, keeping the panel on screen, and on a
 * phone sending the button straight to the system share sheet (`navigator.share`). No third-party
 * code, no tracker, no request to anywhere but the network the reader picks.
 */
import { shareTargets } from '../lib/share';

interface Props {
  /** The story's canonical URL: what gets shared, untouched. */
  url: string;
  title: string;
  summary: string;
  /** `top` sits in the byline; `bottom` closes the story with its own rule above it. */
  placement: 'top' | 'bottom';
}

const { url, title, summary, placement } = Astro.props;
const targets = shareTargets({ url, title, summary });
---

<div class={`share share--${placement}`} data-share data-share-url={url} data-share-title={title} data-share-text={summary} data-pagefind-ignore>
  <details class="share__menu">
    <summary class="share__button">Share<span class="sr-only"> this story</span></summary>
    <div class="share__panel" role="group" aria-label="Share this story">
      <ul class="share__links">
        {targets.map((target) => (
          <li>
            <a
              href={target.href}
              {...(target.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{target.label}{target.external && <span class="sr-only"> (opens in a new tab)</span>}</a>
          </li>
        ))}
        <li><button type="button" class="share__copy" data-share-copy hidden>Copy link</button></li>
      </ul>
      <p class="share__status" role="status" aria-live="polite" data-share-status></p>
    </div>
  </details>
</div>

<script>
  const STATUS_CLEAR_MS = 4000;
  const EDGE_GAP_PX = 16;

  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-share]'));
  const touch = window.matchMedia('(pointer: coarse)').matches;
  const canShareNatively = touch && typeof navigator.share === 'function';
  const canCopy = typeof navigator.clipboard?.writeText === 'function';

  const closeAll = (except?: Element | null) => {
    for (const root of roots) {
      const menu = root.querySelector('details');
      if (menu && menu !== except) menu.open = false;
    }
  };

  for (const root of roots) {
    const { shareUrl = '', shareTitle = '', shareText = '' } = root.dataset;
    const menu = root.querySelector<HTMLDetailsElement>('details');
    const button = root.querySelector<HTMLElement>('summary');
    const panel = root.querySelector<HTMLElement>('.share__panel');
    const copy = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    if (!menu || !button || !panel) continue;
    let clearTimer: ReturnType<typeof setTimeout> | undefined;

    const say = (message: string) => {
      if (!status) return;
      status.textContent = message;
      clearTimeout(clearTimer);
      clearTimer = setTimeout(() => { status.textContent = ''; }, STATUS_CLEAR_MS);
    };

    // On a phone the button opens the system share sheet. If that fails, the menu opens as usual.
    let nativeFailed = false;
    if (canShareNatively) {
      button.addEventListener('click', async (event) => {
        if (nativeFailed) return;
        event.preventDefault();
        try {
          await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          nativeFailed = true;
          menu.open = true;
        }
      });
    }

    // Keep the panel inside the screen: flip it to the button's right edge when it would run off.
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      closeAll(menu);
      panel.classList.remove('share__panel--right');
      if (panel.getBoundingClientRect().right > window.innerWidth - EDGE_GAP_PX) panel.classList.add('share__panel--right');
    });

    if (copy && canCopy) {
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(shareUrl);
          say('Link copied.');
        } catch {
          say('Could not copy. Copy the address from the address bar instead.');
        }
      });
    }

    // A chosen link has done its job: close the menu.
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  }

  document.addEventListener('click', (event) => {
    const inside = (event.target as Element | null)?.closest('[data-share]');
    closeAll(inside?.querySelector('details'));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = roots.find((root) => root.querySelector('details')?.open);
    if (!open) return;
    closeAll();
    open.querySelector<HTMLElement>('summary')?.focus();
  });
</script>
