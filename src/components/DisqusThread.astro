---
/**
 * The Disqus thread that carried story comments before the site's own (`Comments.astro`). It
 * stays below the new section until Disqus is removed site-wide (plan task A4), so a reader can
 * still see anything posted there. No `id="comments"`: that anchor belongs to the new section.
 */
import { DISQUS_SHORTNAME } from '../lib/site';

interface Props {
  /** Canonical story URL on aitamer.news. Keeps one thread per story. */
  pageUrl: string;
  /** Stable id for the thread. The post slug. */
  pageId: string;
}

const { pageUrl, pageId } = Astro.props;
const shortname = DISQUS_SHORTNAME;
---
<section class="comments comments--disqus" aria-labelledby="disqus-title">
  <h2 id="disqus-title">Earlier comments, on Disqus</h2>
  <div id="disqus_thread"></div>
  <script is:inline define:vars={{ pageUrl, pageId, shortname }}>
    window.disqus_config = function () {
      this.page.url = pageUrl;
      this.page.identifier = pageId;
    };
    (function () {
      var d = document, s = d.createElement('script');
      s.src = 'https://' + shortname + '.disqus.com/embed.js';
      s.setAttribute('data-timestamp', +new Date());
      (d.head || d.body).appendChild(s);
    })();
  </script>
  <noscript>
    Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus</a>.
  </noscript>
</section>
