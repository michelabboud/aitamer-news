---
/**
 * A story's comments, baked into the page at build time from its data file
 * (`src/content/comments/<slug>.json`, ADR 0006; plan §6.2). No request leaves the page to show
 * them. What to show comes from `commentViews` (pure, tested in `src/lib/comment-text.test.ts`):
 * text through `renderCommentHtml` (escaped, paragraphs, `http(s)` links only) and never through
 * the Markdown pipeline; names stripped of forbidden characters, then Astro-escaped as text.
 * Name and text carry `dir="auto"`, so a right-to-left comment reads right to left without
 * reordering its neighbours.
 *
 * A withdrawn story renders nothing here: no comments and no form.
 */
import type { CollectionEntry } from 'astro:content';
import { commentCountLabel, commentViews } from '../lib/comment-text';
import { formatDateTime } from '../lib/site';
import CommentForm from './CommentForm.astro';

type Comment = CollectionEntry<'comments'>['data']['comments'][number];

interface Props {
  /** The post's id, which is also its comment file's name. */
  slug: string;
  /** The approved comments, oldest first, as the data file holds them. Empty when there is no file. */
  comments: readonly Comment[];
  /** A withdrawn story shows no comments and takes none. */
  withdrawn: boolean;
  /** `comments: { closed: true }` in the post's frontmatter: the thread stays, the form does not. */
  closed?: boolean;
}

const { slug, comments, withdrawn, closed = false } = Astro.props;
const views = commentViews(comments, withdrawn);
---
{views && (
  <section class="comments" id="comments" aria-labelledby="comments-title" data-thread={slug}>
    <div class="comments__head">
      <h2 id="comments-title">The Campfire</h2>
      <span class="comments__count">{commentCountLabel(comments.length)}</span>
    </div>

    {views.length === 0 ? (
      <p class="comments__empty">
        Nobody has pulled up a log by this one yet. Be the first to say what you make of it.
      </p>
    ) : (
      <ol class="comment-list">
        {views.map((comment) => (
          <li>
            <article class="comment" id={comment.anchor} aria-labelledby={comment.nameId}>
              <header class="comment__meta">
                <span class="comment__name" id={comment.nameId} dir="auto">{comment.name}</span>
                {comment.signedIn && (
                  <span class="comment__signed" title="Signed in when they wrote this">Signed in</span>
                )}
                <a class="comment__time" href={`#${comment.anchor}`} title="Link to this comment">
                  <time datetime={comment.at}>{formatDateTime(new Date(comment.at))}</time>
                </a>
                <span class="comment__id" title="This comment's id: quote it to the desk to ask for a removal">
                  {comment.id}
                </span>
              </header>
              <div class="comment__text" dir="auto" set:html={comment.html} />
            </article>
          </li>
        ))}
      </ol>
    )}

    <CommentForm slug={slug} closed={closed} />
  </section>
)}
