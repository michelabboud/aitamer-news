---
/**
 * Small "Pinned" label for a post the homepage pin card is showing this build.
 * Callers decide membership (`loadHomepagePins`); this component is the label only.
 * The icon is decorative. The visible word is the accessible name.
 */
---
<span class="pin-badge" data-pagefind-ignore><svg class="pin-badge__icon" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M8 1.75a4.25 4.25 0 0 0-4.25 4.25c0 3.2 4.25 8.25 4.25 8.25s4.25-5.05 4.25-8.25A4.25 4.25 0 0 0 8 1.75Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><circle cx="8" cy="6" r="1.35" fill="currentColor" /></svg><span class="pin-badge__text">Pinned</span></span>
