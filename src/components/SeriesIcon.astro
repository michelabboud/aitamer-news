---
/**
 * The series mark inherits `currentColor` through inline SVG or a CSS mask for
 * inert homepage batches, whose protocol admits HTML elements only. Hidden from assistive tech:
 * the series name sits in the text beside it. A series without its own icon (one a bot added
 * through the series lane, ADR 0054) shows the neutral default until a person draws one.
 */
import grokBot from '../assets/series-icons/grok-bot.svg?raw';
import imageModels from '../assets/series-icons/ai-image-models.svg?raw';
import movieModels from '../assets/series-icons/ai-movie-models.svg?raw';
import voiceModels from '../assets/series-icons/ai-voice-models.svg?raw';
import vectors from '../assets/series-icons/vectors-plainly.svg?raw';
import fallback from '../assets/series-icons/default.svg?raw';

interface Props {
  slug: string;
  rendering?: 'inline' | 'mask';
}

const ICONS: Record<string, string> = {
  'grok-bot': grokBot,
  'ai-image-models': imageModels,
  'ai-movie-models': movieModels,
  'ai-voice-models': voiceModels,
  'vectors-plainly': vectors,
};

const svg = Object.hasOwn(ICONS, Astro.props.slug) ? ICONS[Astro.props.slug] : fallback;
const iconSlug = Object.hasOwn(ICONS, Astro.props.slug) ? Astro.props.slug : 'default';
---
{Astro.props.rendering === 'mask' ? (
  <span class:list={['series-icon', 'series-icon--mask', `series-icon--${iconSlug}`]} aria-hidden="true" />
) : (
  svg && <span class="series-icon" aria-hidden="true" set:html={svg} />
)}
