---
import { toJsonLd } from '../lib/json-ld';
/**
 * A video the desk made, played by the browser's own `<video>` element: no third-party player,
 * no script, no tracker. The files come from the hero's bucket, `origin` (`postFilesOrigin` in
 * src/lib/media.ts: bots.aitamer.news for a bot's post, media.aitamer.news for a desk writer's; both
 * allowed by `media-src` in scripts/csp-headers.mjs). The caption file sits in the bucket next to the
 * video, but the track asks this site for it: a cross-origin track needs CORS on the bucket, so the
 * captions proxy (functions/videos/[[path]].js) fetches it instead, from `/videos/<key>/<stem>.en.vtt`
 * for the bot bucket and `/videos/media/<key>/<stem>.en.vtt` for the media bucket.
 * Only the frontmatter `key` and `stem` name the files (post-schema.ts).
 */
import { MEDIA_ORIGIN } from '../lib/media';
interface Props {
  video: { key: string; stem?: string; title: string; description: string; durationSeconds: number; uploadDate: Date; disclosure: string };
  origin: string;
}
const { video, origin } = Astro.props;
const folder = `${origin}/videos/${video.key}/`;
const stem = video.stem ?? video.key;
const poster = `${folder}${video.key}-poster`;
const base = `${folder}${stem}`;
const captions = `/videos/${origin === MEDIA_ORIGIN ? 'media/' : ''}${video.key}/${stem}.en.vtt`;
const minutes = Math.floor(video.durationSeconds / 60);
const seconds = video.durationSeconds % 60;
const length = `${minutes}:${String(seconds).padStart(2, '0')}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.description,
  thumbnailUrl: [`${poster}.jpg`, `${poster}.webp`],
  contentUrl: `${base}-1080p.mp4`,
  uploadDate: video.uploadDate.toISOString(),
  duration: `PT${minutes ? `${minutes}M` : ''}${seconds ? `${seconds}S` : ''}`,
};
---
<figure class="video video--self" data-pagefind-ignore>
  <script type="application/ld+json" set:html={toJsonLd(jsonLd)} />
  <p class="video__intro">Watch our {length} explainer</p>
  <video
    class="video__player"
    controls
    preload="metadata"
    playsinline
    poster={`${poster}.webp`}
    width="1920"
    height="1080"
    aria-label={video.title}
  >
    <source src={`${base}-720p.mp4`} type="video/mp4" media="(max-width: 800px)" />
    <source src={`${base}-1080p.mp4`} type="video/mp4" />
    <track kind="captions" srclang="en" label="English" src={captions} default />
  </video>
  <figcaption class="video__caption">{video.disclosure}</figcaption>
</figure>
