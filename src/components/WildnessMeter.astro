---
import { WILDNESS_LABELS, wildnessTokens, type WildnessRating } from '../lib/site';

interface Props {
  level: WildnessRating;
  /** lg 8px (lead, article), md 6px (field log), sm 5px (cards). */
  size?: 'lg' | 'md' | 'sm';
}
const { level, size = 'lg' } = Astro.props;
const label = `Wildness ${level} of 5: ${WILDNESS_LABELS[level]}`;
---
<div class:list={['meter', size !== 'lg' && `meter--${size}`]} role="img" aria-label={label}>
  {wildnessTokens(level).map((token) => <span style={`background: var(${token})`}></span>)}
</div>
