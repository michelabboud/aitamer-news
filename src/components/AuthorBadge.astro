---
import { kindLabel, type AuthorKind } from '../lib/author-kinds.ts';
interface Props {
  kind: AuthorKind;
  /** Author name, shown after the kind: "BOT · DESK BOT". */
  name?: string;
}
const { kind, name } = Astro.props;
const label = kindLabel(kind);
---
<span class={`tag tag--${kind}`}>{name ? `${label} · ${name}` : label}</span>
