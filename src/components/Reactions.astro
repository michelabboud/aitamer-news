---
/**
 * Reactions under a story: one "React" button, a compact summary of the baked totals beside it,
 * and a small panel of the seven reactions (`REACTIONS` in `src/lib/reactions.ts`). Rendered by
 * `src/pages/posts/[slug].astro` only while `REACTIONS_LIVE` is on and the story is not withdrawn.
 *
 * Where the totals come from is the switch `REACTIONS_SOURCE` in `src/lib/site.ts`:
 *
 * - **`'baked'`** (today): baked into the page from `src/content/reactions/<slug>.json` (absent =
 *   zero), so reading costs nothing and the counts show without script.
 * - **`'r2'`** (docs/plans/2026-10-24-comments-on-r2.md §2.5, task R4): the script fetches
 *   `v1/reactions/<slug>.json` from the data host (`COMMENTS_DATA_BASE`, carried in
 *   `data-comments-base`, which is also what puts the host in the CSP's `connect-src`) once, with
 *   `credentials: 'omit'`, through the data host's shared load machine (`src/lib/data-host.ts`).
 *   A 404 is zero. A file `validateReactionFile` refuses, an error status, no answer or the 10 s
 *   timeout leave the buttons working with no count anywhere (the choices read "Overhyped", the
 *   summary stays empty); opening the panel loads again, quietly, after a failure. The summary
 *   keeps its place and width while it is empty (`data-reserved`, `visibility: hidden`), so the
 *   counts arriving move nothing. A closed story's summary is filled the same way.
 *
 * The reader's own choice comes from `localStorage` (never a cookie). Choosing costs one small
 * `POST /react` to the comments Worker, sent with `keepalive`. The counts on the page move
 * optimistically for this visit only (+1 new, −1 old), without fetching the totals again; a tap
 * made before the totals arrived is laid over them when they do (`liveCounts`). The file catches up
 * on a later publish (baked) or within about a minute (r2).
 *
 * A choice is stored as **unsent** until the Worker answers `ok` (a removal as an unsent
 * tombstone), so nothing is lost when the reader leaves before a request goes out, or when the
 * Worker refuses quietly (a rate limit, the daily cap, offline, a timeout): the choice stays shown,
 * and the page sends it again **once per load of that story** until the desk confirms it or the
 * record expires after 30 days. A permanent refusal (400, 403) drops the record instead: it
 * would only be refused again. A 404 is not permanent: a story published minutes ago is not yet in
 * the Worker's cached list of stories. Tapping the choice the button shows removes it, as ever. A 410
 * closes reactions on the page (both buttons disabled, the note says why, and takes the focus only
 * when it answers the reader's own tap — never on the on-load resend).
 * Nothing is logged. The script runs only on the hosts the Worker accepts (`REACTION_HOSTS`); on
 * any other host (a mirror, a `pages.dev` address) it removes the interactive component instead.
 *
 * The panel is a native `popover` (light dismiss and Escape come free), positioned by the script
 * from the button that opened it because the top layer ignores the page's layout; a browser
 * without `popover` gets the same handlers with `hidden`, and without script as well the panel is
 * not shown at all (`global.css`). Keyboard: Tab to the button, Enter opens, focus goes to the
 * current choice (else the first), arrows and Home/End move (roving `tabindex`), Enter or Space
 * chooses, Escape closes and focus returns to the button, Tab leaves and closes. Focus is put back
 * only when it was inside the panel as it closed, so dismissing it by tapping the page never
 * scrolls. Screen readers hear "React, menu" and "Overhyped, 12 reactions" (`menuitemradio`,
 * `aria-checked`).
 *
 * The behaviour is the bundled `<script>` below: one file, cached across every story page, that
 * imports its rules from `src/lib/reactions.ts` (tested there). Per-page values travel in `data-*`
 * attributes on the section.
 */
import { COMMENTS_DATA_BASE, COMMENTS_ENDPOINT, REACTIONS_SOURCE } from '../lib/site';
import { dataBaseUrl } from '../lib/data-host';
import {
  REACTIONS,
  REACTIONS_CLOSED_MESSAGE,
  REACTIONS_NO_SCRIPT_MESSAGE,
  reactEndpoint,
  reactionLabel,
  reactionTotals,
  summaryLabel,
  topReactions,
} from '../lib/reactions';

interface Props {
  /** The post's slug: the story reacted to. */
  slug: string;
  /** The story's baked reactions file, or `undefined` when it has none (zero reactions). Unused when the source is `'r2'`. */
  file?: { reactions: readonly { id: string; n: number }[] };
  /** Comments closed on the story (`comments: { closed: true }`): the summary stays, choosing does not. */
  closed?: boolean;
}

const { slug, file, closed = false } = Astro.props;
const live = REACTIONS_SOURCE === 'r2';
// A wrong PUBLIC_COMMENTS_DATA_BASE fails the build here, naming the problem, rather than every reader's page.
const dataBase = live ? dataBaseUrl(COMMENTS_DATA_BASE).href : undefined;
const totals = reactionTotals(live ? undefined : file);
const top = topReactions(totals.known);
const summary = summaryLabel(totals);
const countOf = (id: string) => totals.known.get(id as never) ?? 0;
const emojiOf = (id: string) => REACTIONS.find((r) => r.id === id)!.emoji;
const panelId = `reactions-panel-${slug}`;
const counts = JSON.stringify(Object.fromEntries(totals.known));
const unknownTotal = totals.total - [...totals.known.values()].reduce((sum, n) => sum + n, 0);
---
<section
  class="reactions"
  aria-label="Reactions"
  data-slug={slug}
  data-endpoint={closed ? undefined : reactEndpoint(COMMENTS_ENDPOINT)}
  data-counts={live ? undefined : counts}
  data-unknown={live ? undefined : String(unknownTotal)}
  data-comments-base={dataBase}
  data-closed={closed ? '' : undefined}
>
  {!closed && (
    <button type="button" class="reactions__react" popovertarget={panelId} aria-haspopup="menu" aria-expanded="false">
      <span class="reactions__own" aria-hidden="true"></span><span class="reactions__mine sr-only"></span><span class="reactions__word">React</span>
    </button>
  )}
  {closed ? (
    <p class:list={['reactions__summary reactions__summary--static', { 'reactions__summary--live': live }]} hidden={!live && totals.total === 0} data-reserved={live ? '' : undefined}>
      <span class="reactions__stack" aria-hidden="true">{top.map((id) => <span class="reactions__stack-emoji">{emojiOf(id)}</span>)}</span>
      <span class="reactions__total" aria-hidden="true">{totals.total.toLocaleString('en-US')}</span>
      <span class="sr-only">{summary}</span>
    </p>
  ) : (
    <button type="button" class:list={['reactions__summary', { 'reactions__summary--live': live }]} popovertarget={panelId} aria-haspopup="menu" aria-expanded="false" aria-label={summary} hidden={!live && totals.total === 0} data-reserved={live ? '' : undefined}>
      <span class="reactions__stack" aria-hidden="true">{top.map((id) => <span class="reactions__stack-emoji">{emojiOf(id)}</span>)}</span>
      <span class="reactions__total" aria-hidden="true">{totals.total.toLocaleString('en-US')}</span>
    </button>
  )}
  {closed ? (
    <p class="reactions__note">{REACTIONS_CLOSED_MESSAGE}</p>
  ) : (
    <>
      <div id={panelId} class="reactions__panel" popover role="menu" aria-label="React to this story">
        <div class="reactions__choices">
          {REACTIONS.map(({ id, emoji }, index) => (
            <button
              type="button"
              class="reactions__choice"
              role="menuitemradio"
              aria-checked="false"
              data-reaction={id}
              aria-label={reactionLabel(id, live ? null : countOf(id))}
              tabindex={index === 0 ? '0' : '-1'}
            ><span aria-hidden="true">{emoji}</span></button>
          ))}
        </div>
        <p class="reactions__caption" aria-hidden="true"></p>
        <noscript><p class="reactions__caption">{REACTIONS_NO_SCRIPT_MESSAGE}</p></noscript>
      </div>
      <p class="reactions__note" role="status" aria-live="polite" tabindex="-1"></p>
    </>
  )}
</section>

<script>
  import {
    REACTIONS,
    REACTIONS_CLOSED_MESSAGE,
    REACTION_REQUEST_FIELDS,
    REACTION_REQUEST_TIMEOUT_MS,
    REACTION_STORAGE_PREFIX,
    applyChoice,
    encodeStoredReaction,
    expiredReactionKeys,
    liveCounts,
    nextChoice,
    reactionCaption,
    reactionLabel,
    reactionOutcome,
    reactionsHostAllowed,
    reactionStorageKey,
    reactionsFileUrl,
    reactionsReader,
    settledRecord,
    parseStoredReaction,
    summaryLabel,
    topReactions,
    type ClientReactionFile,
    type ReactionId,
    type ReactionOutcome,
    type StoredReaction,
  } from '../lib/reactions';
  import { fetchDataFile, initialLoadState, loadTransition, type DataEvent, type LoadState } from '../lib/data-host';

  const EMOJI = new Map<string, string>(REACTIONS.map((r) => [r.id, r.emoji]));
  const LABEL = new Map<string, string>(REACTIONS.map((r) => [r.id, r.label]));
  const numberFormat = new Intl.NumberFormat('en-US');

  /**
   * Loads a story's totals from the data host (`REACTIONS_SOURCE = 'r2'`) and reports every state
   * the load enters. An answer to an earlier attempt is ignored by the machine.
   * @returns a retry, which does something only after a failure
   */
  function loadTotals(slug: string, base: string, onState: (state: LoadState<ClientReactionFile>) => void): () => void {
    let url: string;
    try {
      url = reactionsFileUrl(base, slug);
    } catch (error) {
      console.error('reactions: the data address is not usable', error);
      return () => {};
    }
    const reader = reactionsReader(slug);
    let state = initialLoadState<ClientReactionFile>();
    function transition(event: DataEvent): void {
      const next = loadTransition(state, event, reader);
      if (next === state) return;
      state = next;
      if (state.phase === 'failed') console.warn(`reactions: totals not shown (${state.failure}: ${state.reason})`);
      onState(state);
      if (state.phase === 'loading') void fetchDataFile(url, state.attempt).then(transition);
    }
    void fetchDataFile(url, state.attempt).then(transition);
    return () => transition({ type: 'retry' });
  }

  /** The summary's stack of top emoji and its total, built with DOM calls only. */
  function fillSummary(stack: HTMLElement, totalText: HTMLElement, known: Map<ReactionId, number>, total: number): void {
    totalText.textContent = numberFormat.format(total);
    stack.replaceChildren(
      ...topReactions(known).map((id) => {
        const span = document.createElement('span');
        span.className = 'reactions__stack-emoji';
        span.textContent = EMOJI.get(id)!;
        return span;
      }),
    );
  }

  function knownOf(counts: Map<string, number>): Map<ReactionId, number> {
    return new Map([...counts].filter(([, n]) => n > 0)) as Map<ReactionId, number>;
  }

  /** A closed story read from the data host: only its static summary is filled in. */
  function setupStatic(root: HTMLElement): void {
    const slug = root.dataset.slug;
    const base = root.dataset.commentsBase;
    const summary = root.querySelector<HTMLElement>('.reactions__summary--static');
    const stack = summary?.querySelector<HTMLElement>('.reactions__stack');
    const totalText = summary?.querySelector<HTMLElement>('.reactions__total');
    const spoken = summary?.querySelector<HTMLElement>('.sr-only');
    if (!slug || !base || !summary || !stack || !totalText || !spoken) return;
    loadTotals(slug, base, (state) => {
      if (state.phase !== 'ready') return;
      const { counts, unknown } = liveCounts(state.value, null, null);
      const known = knownOf(counts);
      let total = unknown;
      for (const n of counts.values()) total += n;
      fillSummary(stack, totalText, known, total);
      spoken.textContent = summaryLabel({ known, unknown: new Map(), total });
      summary.toggleAttribute('data-reserved', total === 0);
    });
  }

  /** Storage can be off, full, or throw on access (private modes, blocked site data). */
  function storage(): Storage | null {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  }

  /** Forget every expired or malformed reactions record, for any story: the 30 days are kept exactly. */
  function sweep(now: Date) {
    const store = storage();
    if (!store) return;
    try {
      const entries: [string, string | null][] = [];
      for (let i = 0; i < store.length; i++) {
        const key = store.key(i);
        if (key !== null && key.startsWith(REACTION_STORAGE_PREFIX)) entries.push([key, store.getItem(key)]);
      }
      for (const key of expiredReactionKeys(entries, now)) store.removeItem(key);
    } catch {
      /* storage unreadable: nothing to sweep */
    }
  }

  function readRecord(key: string): StoredReaction | null {
    try {
      return parseStoredReaction(storage()?.getItem(key) ?? null, new Date());
    } catch {
      return null;
    }
  }

  function writeRecord(key: string, record: StoredReaction | null) {
    try {
      const store = storage();
      if (!store) return;
      if (record === null) store.removeItem(key);
      else store.setItem(key, encodeStoredReaction(record));
    } catch {
      /* storage off or full: the choice still shows for this visit */
    }
  }

  function setup(root: HTMLElement) {
    const panel = root.querySelector<HTMLElement>('.reactions__panel');
    const reactButton = root.querySelector<HTMLButtonElement>('.reactions__react');
    const summaryButton = root.querySelector<HTMLButtonElement>('button.reactions__summary');
    const endpoint = root.dataset.endpoint;
    const slug = root.dataset.slug;
    if (!panel || !reactButton || !summaryButton || !endpoint || !slug) return;
    const own = root.querySelector<HTMLElement>('.reactions__own')!;
    const mine = root.querySelector<HTMLElement>('.reactions__mine')!;
    const word = root.querySelector<HTMLElement>('.reactions__word')!;
    const stack = root.querySelector<HTMLElement>('.reactions__stack')!;
    const totalText = root.querySelector<HTMLElement>('.reactions__total')!;
    const caption = panel.querySelector<HTMLElement>('.reactions__caption')!;
    const note = root.querySelector<HTMLElement>('.reactions__note')!;
    const choices = Array.from(panel.querySelectorAll<HTMLButtonElement>('.reactions__choice'));
    const openers = [reactButton, summaryButton];
    const key = reactionStorageKey(slug);
    const native = Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover');
    // Read from the data host (r2): no count is shown until the totals have loaded, and none at all
    // if they cannot be. Baked: the counts are in the page.
    const base = root.dataset.commentsBase;
    let countsKnown = base === undefined;

    let baked: Record<string, number> = {};
    try {
      baked = JSON.parse(root.dataset.counts ?? '{}');
    } catch {
      baked = {};
    }
    let unknownTotal = Number(root.dataset.unknown) || 0;
    let counts = new Map<string, number>(REACTIONS.map((r) => [r.id, Number(baked[r.id]) || 0]));

    let record = readRecord(key);
    let choice: ReactionId | null = record?.r ?? null;
    /** The choice the page remembered as it loaded: the totals are taken to include it. */
    const choiceAtLoad = choice;
    let opener: HTMLButtonElement = reactButton;
    let closedNow = false;
    let focusWasInside = false;
    // A tap outside the panel light-dismisses it; the close that follows must not pull focus (and
    // the scroll) back to the button. The toggle event is queued after the pointer events, so the
    // time of the last outside pointer press tells the two kinds of close apart.
    let outsidePressAt = -Infinity;
    const OUTSIDE_PRESS_WINDOW_MS = 1000;
    document.addEventListener(
      'pointerdown',
      (event) => {
        const target = event.target as Element | null;
        if (target && !panel.contains(target) && !openers.some((b) => b.contains(target))) outsidePressAt = performance.now();
      },
      true,
    );

    function total() {
      let sum = unknownTotal;
      for (const n of counts.values()) sum += n;
      return sum;
    }
    function known() {
      return knownOf(counts);
    }
    /** A choice's count, or `null` while the totals are not known (its label and caption then name it only). */
    function countOf(id: string): number | null {
      return countsKnown ? (counts.get(id) ?? 0) : null;
    }

    function render() {
      if (choice) {
        own.textContent = EMOJI.get(choice)!;
        mine.textContent = 'Your reaction: ';
        word.textContent = LABEL.get(choice)!;
      } else {
        own.textContent = '';
        mine.textContent = '';
        word.textContent = 'React';
      }
      const t = total();
      if (base === undefined) summaryButton.hidden = t === 0;
      // Read from the data host, the summary keeps its place while it has nothing to show.
      else summaryButton.toggleAttribute('data-reserved', !countsKnown || t === 0);
      summaryButton.setAttribute('aria-label', summaryLabel({ known: known(), unknown: new Map(), total: t }));
      fillSummary(stack, totalText, known(), t);
      for (const button of choices) {
        const id = button.dataset.reaction!;
        button.setAttribute('aria-checked', id === choice ? 'true' : 'false');
        button.setAttribute('aria-label', reactionLabel(id, countOf(id)));
      }
      const focused = choices.find((b) => b === document.activeElement);
      if (focused) caption.textContent = reactionCaption(focused.dataset.reaction!, countOf(focused.dataset.reaction!));
    }

    let retryTotals = () => {};

    // --- requests: one in flight, the latest unsent record queued behind it ---
    let inFlight = false;
    /** The latest intent waiting behind the request in flight, and whether the reader just made it. */
    let queued: { record: StoredReaction; byReader: boolean } | undefined;

    function post(sent: StoredReaction): Promise<ReactionOutcome> {
      const body = new URLSearchParams();
      body.set(REACTION_REQUEST_FIELDS.slug, slug!);
      body.set(REACTION_REQUEST_FIELDS.reaction, sent.r ?? '');
      const signal = typeof AbortSignal !== 'undefined' && 'timeout' in AbortSignal ? AbortSignal.timeout(REACTION_REQUEST_TIMEOUT_MS) : undefined;
      return fetch(endpoint!, { method: 'POST', body, headers: { Accept: 'application/json' }, keepalive: true, credentials: 'omit', signal }).then(
        (response) => reactionOutcome(response.status),
        () => reactionOutcome(null),
      );
    }

    /**
     * @param byReader true for a tap the reader just made; false for the once-per-load resend of an
     *   unsent record, which must never move focus or scroll the page
     */
    function send(sent: StoredReaction, byReader: boolean) {
      if (inFlight) {
        queued = { record: sent, byReader };
        return;
      }
      inFlight = true;
      post(sent).then((outcome) => {
        inFlight = false;
        // ok confirms the record; a permanent refusal (400, 403, 410) drops it, since it would only be
        // refused again; 'failed' (404 included) is quiet and leaves it unsent for the next load.
        const settled = settledRecord(readRecord(key), sent, outcome);
        if (settled !== undefined) writeRecord(key, settled);
        if (outcome === 'closed') {
          closeReactions(byReader);
          return;
        }
        if (queued !== undefined && !closedNow) {
          const next = queued;
          queued = undefined;
          send(next.record, next.byReader);
        }
      });
    }

    /** @param byReader the close answers the reader's own tap: only then may focus move to the note */
    function closeReactions(byReader: boolean) {
      const active = document.activeElement;
      const hadFocus = byReader && active !== null && root.contains(active);
      closedNow = true;
      queued = undefined;
      hide();
      reactButton!.disabled = true;
      summaryButton!.disabled = true;
      note.textContent = REACTIONS_CLOSED_MESSAGE;
      // After the reader's own tap, a disabled button would drop focus to the page; the note takes
      // it, so a keyboard or screen-reader reader stays where they were and hears why. An answer to
      // the on-load resend moves nothing: the note is a live region and is announced anyway.
      if (hadFocus) note.focus();
    }

    // --- the panel ---
    const isOpen = () => (native ? panel.matches(':popover-open') : !panel.hidden);
    function show() {
      if (native) panel!.showPopover();
      else {
        panel!.hidden = false;
        opened();
      }
    }
    function hide() {
      if (!isOpen()) return;
      focusWasInside = panel!.contains(document.activeElement);
      if (native) panel!.hidePopover();
      else {
        panel!.hidden = true;
        closed();
      }
    }

    function place() {
      const gutter = parseFloat(getComputedStyle(document.documentElement).fontSize) * 0.5;
      const gap = gutter * 0.75;
      const rect = opener.getBoundingClientRect();
      const width = panel!.offsetWidth;
      const height = panel!.offsetHeight;
      const viewWidth = document.documentElement.clientWidth;
      const viewHeight = window.innerHeight;
      let top = rect.bottom + gap;
      if (top + height > viewHeight - gutter && rect.top - gap - height >= gutter) top = rect.top - gap - height;
      top = Math.max(gutter, Math.min(top, viewHeight - height - gutter));
      const left = Math.max(gutter, Math.min(rect.left, viewWidth - width - gutter));
      // Without script the stylesheet centres the panel in the viewport; placed, it sits by its
      // button instead.
      panel!.style.inset = 'auto';
      panel!.style.margin = '0';
      panel!.style.top = `${top}px`;
      panel!.style.left = `${left}px`;
    }
    let placing = 0;
    function placeSoon() {
      if (placing || !isOpen()) return;
      placing = window.requestAnimationFrame(() => {
        placing = 0;
        if (isOpen()) place();
      });
    }

    function rove(target: HTMLButtonElement) {
      for (const button of choices) button.tabIndex = button === target ? 0 : -1;
      target.focus();
    }
    function opened() {
      // The reader is looking for the counts: after a failed load, this is the moment to try again.
      retryTotals();
      for (const button of openers) button.setAttribute('aria-expanded', button === opener ? 'true' : 'false');
      place();
      panel!.classList.remove('reactions__panel--placing');
      rove(choices.find((b) => b.dataset.reaction === choice) ?? choices[0]);
      window.addEventListener('resize', placeSoon);
      window.addEventListener('scroll', placeSoon, true);
    }
    function closed() {
      for (const button of openers) button.setAttribute('aria-expanded', 'false');
      caption.textContent = '';
      window.removeEventListener('resize', placeSoon);
      window.removeEventListener('scroll', placeSoon, true);
      if (closedNow || !focusWasInside || performance.now() - outsidePressAt < OUTSIDE_PRESS_WINDOW_MS) return;
      // Focus goes back only if it was in the panel as it closed (Escape, a choice) and has not
      // moved on since (Tab). A tap elsewhere on the page keeps focus, and the scroll, where it is.
      const active = document.activeElement;
      if (active && active !== document.body && !panel!.contains(active) && active !== opener) return;
      const target = opener.hidden || opener.disabled ? reactButton! : opener;
      if (!target.disabled) target.focus();
    }

    for (const button of openers) {
      button.addEventListener('click', (event) => {
        opener = button;
        if (!native) {
          event.preventDefault();
          if (isOpen()) hide();
          else show();
        }
      });
    }
    if (native) {
      panel.addEventListener('beforetoggle', (event) => {
        const toggle = event as ToggleEvent;
        if (toggle.newState === 'open') panel.classList.add('reactions__panel--placing');
        else focusWasInside = panel.contains(document.activeElement);
      });
      panel.addEventListener('toggle', (event) => {
        if ((event as ToggleEvent).newState === 'open') opened();
        else closed();
      });
    } else {
      panel.hidden = true;
      panel.removeAttribute('popover');
      panel.classList.add('reactions__panel--scripted');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          event.preventDefault();
          hide();
        }
      });
      document.addEventListener('pointerdown', (event) => {
        const target = event.target as Element | null;
        if (isOpen() && target && !panel.contains(target) && !openers.some((b) => b.contains(target))) hide();
      });
    }

    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        hide();
        return;
      }
      const index = choices.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      let next: HTMLButtonElement | null = null;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = choices[(index + 1) % choices.length];
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = choices[(index - 1 + choices.length) % choices.length];
      else if (event.key === 'Home') next = choices[0];
      else if (event.key === 'End') next = choices[choices.length - 1];
      if (next) {
        event.preventDefault();
        rove(next);
      }
    });

    for (const button of choices) {
      const id = button.dataset.reaction!;
      const showCaption = () => {
        caption.textContent = reactionCaption(id, countOf(id));
      };
      button.addEventListener('pointerenter', showCaption);
      button.addEventListener('focus', showCaption);
      button.addEventListener('pointerleave', () => {
        if (document.activeElement !== button) caption.textContent = '';
      });
      button.addEventListener('click', () => {
        if (closedNow) return;
        const next = nextChoice(choice, id as ReactionId);
        counts = applyChoice(counts, choice, next);
        choice = next;
        record = { r: next, at: new Date().toISOString(), unsent: true };
        writeRecord(key, record);
        render();
        if (next !== null) rise(EMOJI.get(next)!);
        hide();
        send(record, true);
      });
    }

    // One short rise-and-fade on the React button; CSS drops it under reduced motion.
    function rise(emoji: string) {
      if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;
      const ghost = document.createElement('span');
      ghost.className = 'reactions__rise';
      ghost.setAttribute('aria-hidden', 'true');
      ghost.textContent = emoji;
      reactButton!.appendChild(ghost);
      ghost.addEventListener('animationend', () => ghost.remove());
    }

    render();
    // A choice the desk has not confirmed goes again, once, on this load.
    if (record?.unsent) send(record, false);
    if (base !== undefined) {
      retryTotals = loadTotals(slug, base, (state) => {
        if (state.phase !== 'ready') return;
        // Laid over the file: whatever the reader chose while it loaded still counts.
        ({ counts, unknown: unknownTotal } = liveCounts(state.value, choiceAtLoad, choice));
        countsKnown = true;
        render();
      });
    }
  }

  sweep(new Date());
  // A closed story's totals are only shown, never sent, so they load on any host.
  document.querySelectorAll<HTMLElement>('.reactions[data-closed][data-comments-base]').forEach(setupStatic);
  if (reactionsHostAllowed(location.hostname)) {
    document.querySelectorAll<HTMLElement>('.reactions[data-endpoint]').forEach(setup);
  } else {
    // The Worker refuses this host, unreadably: a button here could never work, so it is not offered.
    document.querySelectorAll<HTMLElement>('.reactions[data-endpoint]').forEach((root) => root.remove());
  }
</script>
