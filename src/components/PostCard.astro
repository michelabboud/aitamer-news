---
import type { CollectionEntry } from 'astro:content';
import WildnessMeter from './WildnessMeter.astro';
import {
  WILDNESS_LABELS,
  formatSpecimen,
  habitatHref,
  habitatOfPost,
  postHref,
  withBase,
  type Wildness,
} from '../lib/site';
import { postCover } from '../lib/covers';

interface Props {
  post: CollectionEntry<'posts'>;
  author: CollectionEntry<'authors'>;
  specimen: number;
  /** Show the description under the title (listing pages). */
  showDesc?: boolean;
  eager?: boolean;
  /** h3 under a section heading (home), h2 directly under the page title (listings). */
  heading?: 'h2' | 'h3';
}
const { post, author, specimen, showDesc = false, eager = false, heading = 'h3' } = Astro.props;
const Heading = heading;
const habitat = habitatOfPost(post);
const href = postHref(post);
const level = post.data.wildness;
const kind = author.data.kind;
---
<article class="card">
  <a class="card__photo" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={withBase(postCover(post))}
      alt=""
      width="1600"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="card__no">No.{formatSpecimen(specimen)}</span>
  </a>
  <div class="card__meta">
    <a href={habitatHref(habitat)}>{habitat.name.toUpperCase()}</a>
    <span class:list={['card__by', `by--${kind}`]}>{kind === 'bot' ? 'BOT' : 'HUMAN'} · {author.data.name.toUpperCase()}</span>
  </div>
  <Heading class="card__title"><a href={href}>{post.data.title}</a></Heading>
  {showDesc && <p class="card__desc">{post.data.description}</p>}
  {level && (
    <div class="card__foot">
      <WildnessMeter level={level} size="sm" />
      <span class="card__wl">Wildness {level}/5 · {WILDNESS_LABELS[level as Wildness]}</span>
    </div>
  )}
</article>
