---
import type { CollectionEntry } from 'astro:content';
import AuthorBadge from './AuthorBadge.astro';
import {
  SECTION_LABELS,
  formatDate,
  postHref,
  authorHref,
  withBase,
  type Section,
} from '../lib/site';
import { postCover } from '../lib/covers';

interface Props {
  post: CollectionEntry<'posts'>;
  author: CollectionEntry<'authors'>;
  /** Lead/feature treatment (horizontal ≥720px). */
  feature?: boolean;
}
const { post, author, feature = false } = Astro.props;
const section = post.data.section as Section;
const cover = postCover(post);
const href = postHref(post);
const cardClass = feature ? 'post-card post-card--feature' : 'post-card';
---
<article class={cardClass}>
  <a class="post-card__cover-link" href={href} tabindex="-1">
    <div class="post-card__cover">
      <img
        src={withBase(cover)}
        alt={post.data.title}
        width="1600"
        height="900"
        loading={feature ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      <span class="badge badge--section">{SECTION_LABELS[section]}</span>
      <AuthorBadge kind={author.data.kind} />
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>
        by <a class="post-card__author" href={authorHref(author.id)}>{author.data.name}</a>
      </span>
    </div>
    <h2 class="post-card__title">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="post-card__desc">
      <a class="post-card__desc-link" href={href}>{post.data.description}</a>
    </p>
  </div>
</article>
