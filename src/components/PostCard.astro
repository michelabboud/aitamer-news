---
import type { CollectionEntry } from 'astro:content';
import WildnessMeter from './WildnessMeter.astro';
import { kindLabel } from '../lib/author-kinds.ts';
import {
  WILDNESS_LABELS,
  formatSpecimen,
  habitatHref,
  habitatOfPost,
  postHref,
  withBase,
  type WildnessRating,
} from '../lib/site';
import { postCoverSource } from '../lib/covers';
import HeroImage from './HeroImage.astro';
import PinBadge from './PinBadge.astro';
import SeriesBadge from './SeriesBadge.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  author: CollectionEntry<'authors'>;
  /** Show the description under the title (listing pages). */
  showDesc?: boolean;
  eager?: boolean;
  /** h3 under a section heading (home), h2 directly under the page title (listings). */
  heading?: 'h2' | 'h3';
  context?: 'home-card' | 'listing';
  /** True for a post shown in the homepage pin card; home feed cards omit the badge. */
  pinned?: boolean;
  /** Live series badge, when this post is a part that is up. */
  series?: { href: string; label: string; slug: string };
}
const { post, author, showDesc = false, eager = false, heading = 'h3', context = 'listing', pinned = false, series } = Astro.props;
const showPin = pinned && context !== 'home-card';
const Heading = heading;
const habitat = habitatOfPost(post);
const href = postHref(post);
const level = post.data.wildness?.rating as WildnessRating | undefined;
const specimen = post.data.specimen;
const kind = author.data.kind;
---
<article class="card">
  <a class="card__photo" href={href} tabindex="-1" aria-hidden="true">
    <HeroImage
      src={postCoverSource(post)}
      alt=""
      width="1600"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      context={context}
    />
    {specimen && <span class="card__no">No.{formatSpecimen(specimen)}</span>}
  </a>
  <div class="card__meta">
    {showPin ? (
      <span class="card__place">
        <a href={habitatHref(habitat)}>{habitat.name.toUpperCase()}</a>
        <PinBadge />
      </span>
    ) : (
      <a href={habitatHref(habitat)}>{habitat.name.toUpperCase()}</a>
    )}
    <span class:list={['card__by', `by--${kind}`]}>{kindLabel(kind).toUpperCase()} · {author.data.name.toUpperCase()}</span>
  </div>
  {series && <SeriesBadge href={withBase(series.href)} label={series.label} slug={series.slug} variant="card" />}
  <Heading class="card__title"><a href={href}>{post.data.title}</a></Heading>
  {showDesc && <p class="card__desc">{post.data.description}</p>}
  {level && (
    <div class="card__foot">
      <WildnessMeter level={level} size="sm" />
      <span class="card__wl">Wildness {level}/5 · {WILDNESS_LABELS[level]}</span>
    </div>
  )}
</article>
