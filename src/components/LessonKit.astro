---
/**
 * Downloads for one lesson. The list is fixed when the page is built: getStaticPaths
 * reads `public/lessonkits/` and puts that inventory in the incremental cache key.
 * When the list is empty, the page does not render this box.
 */
import { withBase } from '../lib/site';
import type { LessonKitLink } from '../lib/lesson-kit.ts';

interface Props {
  links: LessonKitLink[];
}
const { links } = Astro.props;
---
<aside class="lesson-kit" aria-labelledby="lesson-kit-title">
  <h2 id="lesson-kit-title">Lesson kit</h2>
  <p>Files for this lesson.</p>
  <ul class="lesson-kit__list">
    {links.map((file) => (
      <li>
        <a href={withBase(file.href)} download={file.filename}>
          <span>{file.label}</span>
          <span class="lesson-kit__file">{file.filename}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
